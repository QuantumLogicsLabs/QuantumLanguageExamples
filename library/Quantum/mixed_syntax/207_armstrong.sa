// Mixed-syntax example 207: Armstrong numbers below 500
# Syntax used: C-style headers, C++, Quantum fn, JavaScript, Ruby do/end

fn is_armstrong(n) {
    let digits = len(str(n))
    s = 0
    int m = n;
    while (m > 0) {
        s += (m % 10) ** digits
        m = floor(m / 10)
    }
    return s == n
}
let found = []
for (int n = 1; n < 500; ++n) {
    if is_armstrong(n)
        found.push_back(n)
    end
}
console.log(found)
