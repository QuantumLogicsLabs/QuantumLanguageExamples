// Mixed-syntax example 127: vowel and consonant counts
# Syntax used: arrow functions, C-style headers, C++, JavaScript, Python blocks, Ruby do/end

const is_vowel = (ch) => {
    for v in ["a", "e", "i", "o", "u"]:
        if ch == v
            return 1
        end
    return 0
}
def count_vowels(s):
    n = 0
    for (i = 0; i < len(s); i++) {
        n += is_vowel(s[i])
    }
    return n
for s in ["apple nectar river velvet ocean", "quiver grape willow frost delta harbor", "apple grape delta"]:
    let v = count_vowels(s);
    int letters = 0;
    for (i = 0; i < len(s); i++) {
        if s[i] != " "
            letters += 1
        end
    }
    puts "#{s}: #{v} vowels, #{letters - v} consonants"
