// Mixed-syntax example 070: Caesar cipher with shift 17
# Syntax used: C-style headers, C++, JavaScript, Python blocks, Ruby do/end

def shift(text, k)
    string out = "";
    for i in range(0, len(text)):
        let ch = text[i];
        code = ord(ch)
        if code >= 97 and code <= 122
            out = out + chr((code - 97 + k) % 26 + 97)
        elsif code >= 65 and code <= 90
            out = out + chr((code - 65 + k) % 26 + 65)
        else
            out = out + ch
        end
    return out
end
(["maple nectar raven", "stone quiver saddle", "QUARTZ piano"]).each do |m|
    let enc = shift(m, 17);
    dec = shift(enc, 9)
    cout << (m) << " -> " << (enc) << endl
    if (dec == m) {
        cout << ("round trip ok") << endl
    } else {
        console.log("round trip FAILED");
    }
end
