// Mixed-syntax example 456: selection sort (descending)
# Syntax used: arrow functions, brace blocks, C-style headers, C++, JavaScript, Python blocks

const selection_sort_desc = (xs) => {
    let a = [];
    for (const v of xs) {
        a.push(v)
    }
    for i in range(0, len(a)):
        int best = i;
        for (int j = i + 1; j < len(a); j += 1) {
            if a[j] > a[best] {
                best = j
            }
        }
        if best != i:
            let t = a[i]
            a[i] = a[best]
            a[best] = t
    return a;
}
result = selection_sort_desc([35, 5, 35, 30, 60, 45, 23])
console.log(result)
cout << "top three: " << (result[0]) << ", " << (result[1]) << ", " << (result[2]) << endl
