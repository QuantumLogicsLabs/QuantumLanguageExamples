// Mixed-syntax example 453: prime sieve up to 46
# Syntax used: brace blocks, C-style headers, C++, Quantum fn, JavaScript, Python blocks, Ruby do/end

fn sieve(n):
    flags = []
    for (let i = 0; i < n + 1; i += 1) {
        flags.append(1);
    }
    flags[0] = 0
    flags[1] = 0
    for p in range(2, n + 1):
        if flags[p] == 1 {
            let m = p * p;
            while m <= n {
                flags[m] = 0
                m += p
            }
        }
    primes = []
    for i in range(2, n + 1):
        if flags[i] == 1:
            primes.append(i)
    return primes
primes = sieve(46)
console.log(primes)
puts "count: #{len(primes)}, largest: #{primes[len(primes) - 1]}"
twins = 0
for i in range(1, len(primes)):
    if (primes[i] - primes[i - 1] == 2) {
        twins += 1
    }
cout << "twin pairs: " << (twins) << endl
