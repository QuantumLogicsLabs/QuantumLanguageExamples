// Mixed-syntax example 312: maximum subarray (Kadane)
# Syntax used: brace blocks, C++, JavaScript, Python blocks, Ruby do/end

function max_subarray(xs) {
    best = xs[0]
    int cur = 0
    let start = 0
    int best_lo = 0
    best_hi = 0
    for i in range(0, len(xs)):
        if cur <= 0
            cur = xs[i]
            start = i
        else
            cur += xs[i]
        end
        if cur > best {
            best = cur;
            best_lo = start
            best_hi = i
        }
    return [best, best_lo, best_hi]
}
let data = [-4, -10, 7, 0, 14, -11, -11, 8]
res = max_subarray(data)
print(f"best sum {res[0]} from index {res[1]} to {res[2]}")
part = []
for i in range(res[1], res[2] + 1):
    part.push(data[i])
console.log(part)
