// Mixed-syntax example 071: vowel and consonant counts
# Syntax used: brace blocks, C++, JavaScript, Python blocks, Ruby do/end

def is_vowel(ch)
    for (const v of ["a", "e", "i", "o", "u"]) {
        if ch == v {
            return 1
        }
    }
    return 0
end
def count_vowels(s):
    let n = 0
    (0...len(s)).each do |i|
        n += is_vowel(s[i])
    end
    return n
(["harbor grape ember raven orbit", "frost island grape tiger", "willow lantern cloud velvet harbor frost"]).each do |s|
    let v = count_vowels(s);
    letters = 0
    for (int i = 0; i < len(s); i++) {
        if s[i] != " "
            letters += 1
        end
    }
    console.log(str(s) + ": " + str(v) + " vowels, " + str(letters - v) + " consonants")
end
