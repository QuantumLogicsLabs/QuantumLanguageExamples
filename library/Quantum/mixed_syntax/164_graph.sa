// Mixed-syntax example 164: breadth-first search on a graph
# Syntax used: brace blocks, C++, JavaScript, Python blocks, Ruby do/end

let nodes = ["a", "b", "c", "d", "e", "f", "g"]
adj = {}
for n in nodes {
    adj[n] = []
}
for (const auto& e : [["a", "b"], ["b", "c"], ["b", "d"], ["b", "f"], ["c", "e"], ["e", "g"], ["g", "e"]]) {
    adj[e[0]].push(e[1])
    adj[e[1]].push(e[0])
}
dist = {}
dist["a"] = 0
queue = ["a"]
head = 0
while head < len(queue)
    let cur = queue[head];
    head += 1
    for nb in adj[cur]:
        if not (nb in dist):
            dist[nb] = dist[cur] + 1
            queue.push(nb)
end
for n in queue {
    print(str(n) + ": distance " + str(dist[n]))
}
console.log(`visited ${len(queue)} of ${len(nodes)}`)
