// Mixed-syntax example 206: perfect, abundant and deficient numbers below 549
# Syntax used: brace blocks, C-style headers, Quantum fn, JavaScript, Python blocks, Ruby do/end

fn divisor_sum(n):
    s = 0
    for d in range(1, n):
        if (n % d == 0) {
            s += d
        }
    return s
let perfect = []
abundant = 0
let deficient = 0;
(2...549).each do |n|
    let s = divisor_sum(n)
    if s == n {
        perfect.push_back(n)
    } else if s > n {
        abundant += 1
    } else {
        deficient += 1;
    }
end
console.log(perfect)
print(f"abundant: {abundant}, deficient: {deficient}")
