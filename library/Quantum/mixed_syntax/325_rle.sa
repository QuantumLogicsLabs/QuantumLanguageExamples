// Mixed-syntax example 325: run-length encoding
# Syntax used: arrow functions, brace blocks, C-style headers, C++, JavaScript, Python blocks

const rle = (s) => {
    let out = ""
    let i = 0;
    while i < len(s):
        j = i
        while (j < len(s) && s[j] == s[i]) {
            j += 1
        }
        out = out + s[i] + str(j - i)
        i = j
    return out
}
function unrle(s) {
    string out = "";
    for (int k = 0; k < floor(len(s) / 2); k++) {
        for t in range(0, int(s[2 * k + 1])) {
            out = out + s[2 * k];
        }
    }
    return out
}
for (auto& s : ["aaacaaaa", "aaabaa", "bbbbccaaabbbbb", "ccccaaabb"]) {
    let enc = rle(s);
    print(f"{s} -> {enc}")
    if (unrle(enc) != s) {
        print("decode mismatch")
    }
}
