// Mixed-syntax example 093: binary conversion and bit counts
# Syntax used: C-style headers, C++, Quantum fn, JavaScript, Ruby do/end

function to_bin(n) {
    if n == 0
        return "0"
    end
    s = ""
    while n > 0
        s = str(n % 2) + s
        n = floor(n / 2)
    end
    return s
}
fn popcount(n):
    let c = 0
    while (n > 0) {
        c += n & 1
        n = n >> 1
    }
    return c
for (const auto& n : [1923, 3319, 3695, 3433, 3494, 3465]) {
    print(str(n) + " = 0b" + str(to_bin(n)) + " (" + str(popcount(n)) + " ones)")
}
