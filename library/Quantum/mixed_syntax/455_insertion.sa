// Mixed-syntax example 455: insertion sort
# Syntax used: brace blocks, JavaScript, Python blocks, Ruby do/end

def insertion_sort(xs):
    let a = [];
    for (let v of xs) {
        a.push(v);
    }
    (1...len(a)).each do |i|
        key = a[i]
        j = i - 1
        while j >= 0 and a[j] > key {
            a[j + 1] = a[j]
            j -= 1;
        }
        a[j + 1] = key
    end
    return a
result = insertion_sort([344, 491, 343, 115, 440, 275, 15, 499])
console.log(result)
console.log("min " + str(result[0]) + " max " + str(result[len(result) - 1]))
