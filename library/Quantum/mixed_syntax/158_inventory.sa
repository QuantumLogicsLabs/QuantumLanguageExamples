// Mixed-syntax example 158: inventory updates in a dictionary
# Syntax used: C++, JavaScript, Python blocks, Ruby do/end

let stock = {"pipes": 7, "chains": 10, "valves": 7, "bolts": 8}
for (const auto& op : [["chains", 1], ["pipes", 2], ["bolts", 1], ["bolts", -2], ["valves", 7], ["chains", 0], ["chains", 0], ["valves", 10], ["chains", 1]]) {
    let name = op[0]
    delta = op[1]
    if stock[name] + delta < 0
        puts "cannot take #{0 - delta} #{name}"
    else
        stock[name] += delta
    end
}
total = 0
stock.keys().each do |k|
    print(f"{k}: {stock[k]}")
    total += stock[k]
end
puts "total items: #{total}"
