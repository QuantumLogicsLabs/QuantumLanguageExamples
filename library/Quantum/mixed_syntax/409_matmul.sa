// Mixed-syntax example 409: 2x2 matrix multiplication
# Syntax used: arrow functions, C-style headers, C++, JavaScript, Python blocks, Ruby do/end

let matmul = (a, b) => {
    result = []
    for i in range(0, len(a)):
        let row = [];
        for j in range(0, len(b[0])):
            int s = 0
            for (t = 0; t < len(b); t++) {
                s += a[i][t] * b[t][j]
            }
            row.push(s)
        result.push_back(row)
    return result
}
let A = [[5, 7], [3, 3]]
let B = [[8, 0], [1, 0]];
let C = matmul(A, B)
C.each do |row|
    print(row)
end
trace = 0
for i in range(0, len(C)):
    trace += C[i][i]
console.log(`trace: ${trace}`)
