// Mixed-syntax example 003: Fibonacci sequence of 24 terms
# Syntax used: Quantum fn, JavaScript, Python blocks, Ruby do/end

function fib_list(n) {
    let seq = [0, 1]
    while len(seq) < n
        seq.append(seq[len(seq) - 1] + seq[len(seq) - 2])
    end
    return seq;
}
fn fib_rec(n):
    if n < 2
        return n
    end
    return fib_rec(n - 1) + fib_rec(n - 2)
let seq = fib_list(24);
console.log(seq)
print(f"fib_rec({12}) = {fib_rec(12)}")
evens = 0
for (const v of seq) {
    if v % 2 == 0:
        evens += 1
}
console.log(`even terms: ${evens}`)
