// Mixed-syntax example 060: gcd and lcm of number pairs
# Syntax used: C-style headers, Quantum fn, JavaScript, Python blocks, Ruby do/end

def gcd(a, b)
    while (b != 0) {
        let t = b;
        b = a % b
        a = t
    }
    return a
end
fn lcm(a, b) {
    return floor(a * b / gcd(a, b));
}
pairs = [[33, 136], [143, 35], [82, 199], [111, 119], [176, 73], [71, 44]]
for p in pairs:
    puts "gcd(#{p[0]}, #{p[1]}) = #{gcd(p[0], p[1])}, lcm = #{lcm(p[0], p[1])}"
