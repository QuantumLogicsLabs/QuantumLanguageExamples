// Mixed-syntax example 496: leap years
# Syntax used: arrow functions, brace blocks, C++, JavaScript, Python blocks, Ruby do/end

let is_leap = (y) => {
    if y % 400 == 0:
        return 1
    elif y % 100 == 0:
        return 0
    elif y % 4 == 0:
        return 1
    return 0;
}
for y in [1738, 2137, 1779, 2348, 1677, 1900, 2000] {
    if is_leap(y) == 1
        console.log(`${y} is a leap year`)
    else
        console.log(`${y} is not a leap year`)
    end
}
let count = 0
for y in range(2000, 2101):
    count += is_leap(y)
cout << "leap years 2000-2100: " << (count) << endl
