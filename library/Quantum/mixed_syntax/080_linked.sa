// Mixed-syntax example 080: singly linked list
# Syntax used: C-style headers, C++, Quantum fn, JavaScript, Python blocks, Ruby do/end

class Node {
    constructor(value) {
        this.value = value
        this.next = None;
    }
}
class LinkedList:
    fn init() {
        self.head = None;
        self.size = 0
    }
    fn push_front(v) {
        let n = Node(v)
        n.next = self.head
        self.head = n;
        self.size += 1
    }
    fn to_list() {
        out = []
        let cur = self.head;
        while (cur != None) {
            out.push_back(cur.value)
            cur = cur.next;
        }
        return out
    }
    fn reverse():
        let prev = null
        let cur = self.head
        while cur != None
            let nxt = cur.next;
            cur.next = prev
            prev = cur
            cur = nxt
        end
        self.head = prev
let lst = LinkedList.new();
for (const auto& v : [76, 56, 31, 23, 48, 77]) {
    lst.push_front(v);
}
console.log(lst.to_list())
lst.reverse()
print(lst.to_list())
console.log(`size: ${lst.size}`)
