// Mixed-syntax example 128: word frequency count
# Syntax used: brace blocks, C-style headers, C++, JavaScript, Python blocks, Ruby do/end

text = "pepper orbit comet orbit piano piano piano comet orbit comet orbit pepper orbit comet kettle kettle"
let words = text.split(" ");
freq = {}
order = []
for (const auto& w : words) {
    if (w in freq) {
        freq[w] += 1;
    } else {
        freq[w] = 1
        order.append(w);
    }
}
for (auto w : order) {
    print(f"{w}: {freq[w]}")
}
let top = order[0]
order.each do |w|
    if freq[w] > freq[top] {
        top = w
    }
end
console.log(`most common: ${top} (${freq[top]})`)
