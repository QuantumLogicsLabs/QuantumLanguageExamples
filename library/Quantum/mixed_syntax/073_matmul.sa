// Mixed-syntax example 073: 3x3 matrix multiplication
# Syntax used: brace blocks, C-style headers, C++, JavaScript, Python blocks

function matmul(a, b) {
    let result = [];
    for i in range(0, len(a)) {
        row = []
        for (j = 0; j < len(b[0]); j += 1) {
            int s = 0
            for (int t = 0; t < len(b); t++) {
                s += a[i][t] * b[t][j];
            }
            row.push(s)
        }
        result.push_back(row);
    }
    return result;
}
A = [[-4, 9, 0], [7, 4, 9], [5, -3, 7]]
let B = [[0, 5, 2], [0, 8, -1], [3, 7, -4]]
C = matmul(A, B)
for row in C {
    print(row);
}
int trace = 0
for i in range(0, len(C)):
    trace += C[i][i]
cout << "trace: " << (trace) << endl
