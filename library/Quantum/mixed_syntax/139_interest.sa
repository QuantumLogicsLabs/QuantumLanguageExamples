// Mixed-syntax example 139: compound interest at 6% over 5 years
# Syntax used: brace blocks, C-style headers, JavaScript, Python blocks

let balance = 223
for y in range(1, 6) {
    balance = balance * (100 + 6) / 100
    printf("year %d: %.2f\n", y, balance)
}
print("growth: %.2f" % (balance - 223))
