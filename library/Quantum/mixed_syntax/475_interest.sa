// Mixed-syntax example 475: compound interest at 5% over 4 years
# Syntax used: brace blocks, C-style headers, JavaScript, Python blocks

let balance = 2467
for y in range(1, 5) {
    balance = balance * (100 + 5) / 100
    print("year %d: %.2f" % (y, balance));
}
printf("growth: %.2f\n", balance - 2467)
