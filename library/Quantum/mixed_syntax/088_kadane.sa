// Mixed-syntax example 088: maximum subarray (Kadane)
# Syntax used: brace blocks, C++, JavaScript, Python blocks, Ruby do/end

def max_subarray(xs):
    let best = xs[0]
    cur = 0
    start = 0
    best_lo = 0
    int best_hi = 0
    for (int i = 0; i < len(xs); i++) {
        if cur <= 0 {
            cur = xs[i]
            start = i;
        } else {
            cur += xs[i];
        }
        if cur > best
            best = cur
            best_lo = start
            best_hi = i
        end
    }
    return [best, best_lo, best_hi]
let data = [0, 2, 6, 9, -9, -4, 8, 5, -15, 12, 1, -2, 6];
res = max_subarray(data)
print("best sum " + str(res[0]) + " from index " + str(res[1]) + " to " + str(res[2]))
part = []
(res[1]...res[2] + 1).each do |i|
    part.push(data[i])
end
console.log(part)
