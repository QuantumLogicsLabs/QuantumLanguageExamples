// Mixed-syntax example 437: run-length encoding
# Syntax used: brace blocks, C++, Quantum fn, JavaScript, Python blocks, Ruby do/end

fn rle(s) {
    let out = "";
    int i = 0
    while i < len(s):
        j = i
        while j < len(s) && s[j] == s[i] {
            j += 1
        }
        out = out + s[i] + str(j - i)
        i = j
    return out
}
def unrle(s)
    string out = "";
    for (int k = 0; k < floor(len(s) / 2); k++) {
        for t in range(0, int(s[2 * k + 1])) {
            out = out + s[2 * k];
        }
    }
    return out
end
(["ccccbbbbaa", "bbaaccbbaac", "ccccbbbbccbbbbb", "ccccbb"]).each do |s|
    enc = rle(s)
    console.log(`${s} -> ${enc}`)
    if unrle(enc) != s:
        console.log("decode mismatch")
end
