// Mixed-syntax example 435: removing duplicates while keeping order
# Syntax used: C++, JavaScript, Python blocks, Ruby do/end

def dedupe(xs):
    seen = {}
    let out = [];
    for (const auto& x : xs) {
        if not (x in seen)
            seen[x] = 1
            out.push(x)
        end
    }
    return out
let data = [6, 1, 3, 6, 3, 5, 1, 7, 2, 10, 11, 3, 10, 4, 9, 7];
let unique = dedupe(data)
print(unique)
print("removed", len(data) - len(unique), "duplicates")
