// Mixed-syntax example 492: merging two sorted lists
# Syntax used: brace blocks, C-style headers, JavaScript, Ruby do/end

def merge(a, b)
    out = []
    i = 0
    j = 0
    while (i < len(a) && j < len(b)) {
        if (a[i] <= b[j]) {
            out.push(a[i])
            i += 1
        } else {
            out.push(b[j])
            j += 1;
        }
    }
    while (i < len(a)) {
        out.push(a[i]);
        i += 1
    }
    while j < len(b) {
        out.append(b[j]);
        j += 1
    }
    return out
end
let merged = merge([3, 5, 7, 9, 9], [2, 9, 10, 30, 32, 50])
console.log(merged)
console.log(`length ${len(merged)}`)
