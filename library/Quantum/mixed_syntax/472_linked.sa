// Mixed-syntax example 472: singly linked list
# Syntax used: brace blocks, Quantum fn, JavaScript, Python blocks, Ruby do/end

class Node {
    constructor(value) {
        this.value = value
        this.next = nil
    }
}
class LinkedList:
    fn init() {
        self.head = nil;
        self.size = 0;
    }
    fn push_front(v) {
        n = new Node(v)
        n.next = self.head
        self.head = n;
        self.size += 1
    }
    fn to_list() {
        out = []
        let cur = self.head;
        while cur != null
            out.push_back(cur.value)
            cur = cur.next
        end
        return out
    }
    fn reverse():
        let prev = nil
        let cur = self.head;
        while cur != null {
            let nxt = cur.next
            cur.next = prev
            prev = cur
            cur = nxt;
        }
        self.head = prev
let lst = new LinkedList()
for v in [10, 98, 72, 87]:
    lst.push_front(v)
console.log(lst.to_list())
lst.reverse()
print(lst.to_list())
puts "size: #{lst.size}"
