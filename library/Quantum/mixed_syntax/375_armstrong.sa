// Mixed-syntax example 375: Armstrong numbers below 1000
# Syntax used: C++, JavaScript, Python blocks, Ruby do/end

function is_armstrong(n) {
    let digits = len(str(n))
    s = 0
    int m = n;
    while m > 0
        s += (m % 10) ** digits
        m = floor(m / 10)
    end
    return s == n;
}
let found = []
for n in range(1, 1000):
    if is_armstrong(n):
        found.push(n)
print(found)
