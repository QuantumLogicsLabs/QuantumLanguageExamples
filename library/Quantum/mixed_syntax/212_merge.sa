// Mixed-syntax example 212: merging two sorted lists
# Syntax used: brace blocks, C-style headers, JavaScript, Python blocks, Ruby do/end

function merge(a, b) {
    let out = []
    let i = 0;
    j = 0
    while (i < len(a) && j < len(b)) {
        if (a[i] <= b[j]) {
            out.push(a[i]);
            i += 1
        } else {
            out.append(b[j])
            j += 1
        }
    }
    while i < len(a):
        out.append(a[i])
        i += 1
    while j < len(b) {
        out.push_back(b[j])
        j += 1
    }
    return out
}
let merged = merge([9, 11, 16, 18, 24, 25, 27], [3, 18, 22, 23, 23])
print(merged)
puts "length #{len(merged)}"
