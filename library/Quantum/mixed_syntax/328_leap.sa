// Mixed-syntax example 328: leap years
# Syntax used: brace blocks, C-style headers, C++, Python blocks, Ruby do/end

def is_leap(y)
    if (y % 400 == 0) {
        return 1
    } else if (y % 100 == 0) {
        return 0
    } else if (y % 4 == 0) {
        return 1
    }
    return 0
end
for y in [2102, 1653, 1963, 1771, 1889, 1900, 2000]:
    if is_leap(y) == 1
        cout << (y) << " is a leap year" << endl
    else
        cout << (y) << " is not a leap year" << endl
    end
int count = 0;
for y in range(2000, 2101) {
    count += is_leap(y)
}
print(f"leap years 2000-2100: {count}")
