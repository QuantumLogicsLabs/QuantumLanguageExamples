// Mixed-syntax example 044: merging two sorted lists
# Syntax used: C-style headers, C++, JavaScript, Python blocks, Ruby do/end

def merge(a, b):
    out = []
    int i = 0;
    let j = 0;
    while (i < len(a) && j < len(b)) {
        if a[i] <= b[j]:
            out.push_back(a[i])
            i += 1
        else:
            out.push_back(b[j])
            j += 1
    }
    while i < len(a):
        out.append(a[i])
        i += 1
    while j < len(b)
        out.push(b[j])
        j += 1
    end
    return out
let merged = merge([7, 25, 25, 35, 39, 44, 44], [3, 4, 6, 24, 27])
print(merged)
print("length", len(merged))
