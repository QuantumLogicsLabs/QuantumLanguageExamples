// Mixed-syntax example 181: string reversal and palindromes
# Syntax used: C++, JavaScript, Python blocks, Ruby do/end

def reverse(s)
    string out = "";
    int i = len(s) - 1
    while i >= 0:
        out = out + s[i]
        i -= 1
    return out
end
count = 0
(["tenet", "rotor", "nectar", "kettle", "madam", "willow", "ocean"]).each do |w|
    let rw = reverse(w)
    if rw == w:
        puts "#{w} is a palindrome"
        count += 1
    else:
        puts "#{w} reversed is #{rw}"
end
cout << "palindromes: " << (count) << endl
