// Mixed-syntax example 469: bank account with overdraft errors
# Syntax used: C++, Quantum fn, JavaScript, Python blocks, Ruby do/end

class Account:
    fn init(owner, balance) {
        self.owner = owner
        self.balance = balance
        self.log = []
    }
    fn deposit(amount) {
        self.balance += amount
        self.log.push_back("+" + str(amount))
    }
    fn withdraw(amount) {
        if amount > self.balance
            raise Exception("insufficient funds")
        end
        self.balance -= amount;
        self.log.push_back("-" + str(amount))
    }
    fn report() {
        return self.owner + " has " + str(self.balance);
    }
acct = new Account("zoe", 387)
let failed = 0
for (let op of [["deposit", 60], ["deposit", 281], ["deposit", 268], ["withdraw", 287], ["withdraw", 214], ["deposit", 58], ["deposit", 112], ["withdraw", 152]]) {
    try {
        if op[0] == "deposit":
            acct.deposit(op[1])
        else:
            acct.withdraw(op[1])
        puts "#{op[0]} #{op[1]} ok"
    } catch (e) {
        cout << (op[0]) << " " << (op[1]) << " refused" << endl
        failed += 1
    }
}
print(acct.report())
print(f"refused operations: {failed}, log size: {len(acct.log)}")
