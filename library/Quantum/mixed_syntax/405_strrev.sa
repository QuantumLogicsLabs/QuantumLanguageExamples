// Mixed-syntax example 405: string reversal and palindromes
# Syntax used: brace blocks, C-style headers, C++, JavaScript, Python blocks, Ruby do/end

def reverse(s)
    let out = ""
    i = len(s) - 1
    while i >= 0 {
        out = out + s[i];
        i -= 1;
    }
    return out
end
int count = 0;
for w in ["kayak", "delta", "raven", "quiver", "harbor", "madam", "noon"]:
    let rw = reverse(w)
    if (rw == w) {
        print(f"{w} is a palindrome");
        count += 1;
    } else {
        console.log(`${w} reversed is ${rw}`);
    }
cout << "palindromes: " << (count) << endl
