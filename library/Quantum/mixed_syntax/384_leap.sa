// Mixed-syntax example 384: leap years
# Syntax used: brace blocks, C++, JavaScript, Python blocks, Ruby do/end

def is_leap(y)
    if y % 400 == 0:
        return 1
    elif y % 100 == 0:
        return 0
    elif y % 4 == 0:
        return 1
    return 0
end
for (const y of [1841, 2086, 1845, 2239, 2330, 1900, 2000]) {
    if is_leap(y) == 1 {
        print(f"{y} is a leap year");
    } else {
        print(y, "is not a leap year");
    }
}
let count = 0;
(2000...2101).each do |y|
    count += is_leap(y)
end
cout << "leap years 2000-2100: " << (count) << endl
