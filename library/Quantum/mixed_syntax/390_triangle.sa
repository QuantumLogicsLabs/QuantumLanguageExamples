// Mixed-syntax example 390: triangle classification
# Syntax used: arrow functions, brace blocks, C++, Ruby do/end

const kind = (a, b, c) => {
    if a + b <= c or a + c <= b or b + c <= a
        return "not a triangle"
    elsif a == b and b == c
        return "equilateral"
    elsif a == b or b == c or a == c
        return "isosceles"
    else
        return "scalene"
    end
}
for t in [[5, 5, 2], [4, 9, 12], [10, 5, 11], [1, 6, 5], [9, 1, 4], [8, 5, 6]] {
    cout << (t[0]) << ", " << (t[1]) << ", " << (t[2]) << ": " << (kind(t[0], t[1], t[2])) << endl
}
