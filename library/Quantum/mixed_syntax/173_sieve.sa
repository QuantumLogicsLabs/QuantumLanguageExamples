// Mixed-syntax example 173: prime sieve up to 80
# Syntax used: brace blocks, C-style headers, C++, JavaScript, Python blocks, Ruby do/end

def sieve(n):
    flags = []
    (0...n + 1).each do |i|
        flags.append(1)
    end
    flags[0] = 0
    flags[1] = 0
    for (p = 2; p < n + 1; p++) {
        if flags[p] == 1 {
            int m = p * p;
            while m <= n {
                flags[m] = 0
                m += p;
            }
        }
    }
    let primes = []
    for (i = 2; i < n + 1; i++) {
        if (flags[i] == 1) {
            primes.push(i);
        }
    }
    return primes
let primes = sieve(80)
console.log(primes)
print("count: " + str(len(primes)) + ", largest: " + str(primes[len(primes) - 1]))
let twins = 0;
for (int i = 1; i < len(primes); i++) {
    if primes[i] - primes[i - 1] == 2
        twins += 1
    end
}
cout << "twin pairs: " << (twins) << endl
