// Mixed-syntax example 223: searching a 5x5 grid
# Syntax used: brace blocks, C++, JavaScript, Ruby do/end

grid = [[6, 5, 2, 0, 6], [7, 8, 5, 5, 3], [5, 4, 8, 3, 5], [4, 8, 5, 0, 3], [9, 5, 4, 1, 4]]
let best = -1;
br = 0
int bc = 0;
zeros = 0
for (int i = 0; i < len(grid); i++) {
    (0...len(grid[i])).each do |j|
        if grid[i][j] > best
            best = grid[i][j]
            br = i
            bc = j
        end
        if grid[i][j] == 0 {
            zeros += 1
        }
    end
}
console.log(`largest ${best} at row ${br}, column ${bc}`)
console.log("zeros: " + str(zeros))
let diag = 0
(0...len(grid)).each do |i|
    diag += grid[i][i] + grid[i][len(grid) - 1 - i]
end
print("diagonal sum: " + str(diag))
