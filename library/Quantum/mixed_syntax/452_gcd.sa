// Mixed-syntax example 452: gcd and lcm of number pairs
# Syntax used: C++, Quantum fn, JavaScript, Ruby do/end

fn gcd(a, b):
    while b != 0
        let t = b
        b = a % b
        a = t
    end
    return a
def lcm(a, b)
    return floor(a * b / gcd(a, b))
end
let pairs = [[62, 14], [26, 76], [62, 93], [82, 116], [82, 191], [149, 99], [188, 91]]
for (auto p : pairs) {
    console.log(`gcd(${p[0]}, ${p[1]}) = ${gcd(p[0], p[1])}, lcm = ${lcm(p[0], p[1])}`);
}
