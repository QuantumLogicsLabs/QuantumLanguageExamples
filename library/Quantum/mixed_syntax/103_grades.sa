// Mixed-syntax example 103: grade classification
# Syntax used: C-style headers, C++, JavaScript, Ruby do/end

function grade(s) {
    if s >= 90
        return "A"
    elsif s >= 80
        return "B"
    elsif s >= 70
        return "C"
    elsif s >= 60
        return "D"
    else
        return "F"
    end
}
names = ["fin", "gia", "bea", "dan", "cam", "eli"]
scores = [50, 78, 84, 84, 46, 67]
let tally = {"A": 0, "B": 0, "C": 0, "D": 0, "F": 0};
for (let i = 0; i < len(names); i += 1) {
    g = grade(scores[i])
    tally[g] += 1
    print(str(names[i]) + ": " + str(scores[i]) + " -> " + str(g))
}
for (let g of ["A", "B", "C", "D", "F"]) {
    cout << (g) << ": " << (tally[g]) << endl
}
