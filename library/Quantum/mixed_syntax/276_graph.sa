// Mixed-syntax example 276: breadth-first search on a graph
# Syntax used: C-style headers, C++, JavaScript, Python blocks, Ruby do/end

let nodes = ["a", "b", "c", "d", "e"];
let adj = {}
for (auto& n : nodes) {
    adj[n] = []
}
for (let e of [["a", "b"], ["a", "c"], ["a", "d"], ["c", "d"], ["c", "e"]]) {
    adj[e[0]].push(e[1]);
    adj[e[1]].push(e[0]);
}
let dist = {}
dist["a"] = 0
let queue = ["a"]
let head = 0
while (head < len(queue)) {
    let cur = queue[head]
    head += 1
    for nb in adj[cur]:
        if not (nb in dist)
            dist[nb] = dist[cur] + 1
            queue.append(nb)
        end
}
for n in queue:
    print(str(n) + ": distance " + str(dist[n]))
print("visited", len(queue), "of", len(nodes))
