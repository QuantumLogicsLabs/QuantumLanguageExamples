// Mixed-syntax example 029: text patterns of height 3
# Syntax used: C-style headers, C++, JavaScript, Python blocks

def repeat(s, k):
    let out = "";
    for (i = 0; i < k; ++i) {
        out = out + s
    }
    return out
# right triangle
for i in range(1, 4):
    cout << repeat("*", i) << endl
# pyramid
for (let i = 0; i < 3; ++i) {
    printf("%s\n", repeat(" ", 3 - i - 1) + repeat("*", 2 * i + 1))
}
# inverted
let k = 3;
while k > 0:
    console.log(repeat("*", k))
    k -= 1
