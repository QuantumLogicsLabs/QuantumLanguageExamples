// Mixed-syntax example 462: Caesar cipher with shift 7
# Syntax used: C-style headers, C++, JavaScript, Python blocks, Ruby do/end

def shift(text, k):
    string out = "";
    for (int i = 0; i < len(text); i += 1) {
        ch = text[i]
        let code = ord(ch)
        if code >= 97 and code <= 122
            out = out + chr((code - 97 + k) % 26 + 97)
        elsif code >= 65 and code <= 90
            out = out + chr((code - 65 + k) % 26 + 65)
        else
            out = out + ch
        end
    }
    return out
for (auto& m : ["apple raven grape", "raven orbit apple", "STONE apple"]) {
    let enc = shift(m, 7);
    dec = shift(enc, 19)
    cout << (m) << " -> " << (enc) << endl
    if dec == m:
        console.log("round trip ok")
    else:
        puts("round trip FAILED")
}
