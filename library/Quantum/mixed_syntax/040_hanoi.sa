// Mixed-syntax example 040: Towers of Hanoi with 3 disks
# Syntax used: C-style headers, C++, JavaScript, Python blocks, Ruby do/end

def hanoi(n, src, dst, via, moves)
    if (n == 0) {
        return;
    }
    hanoi(n - 1, src, via, dst, moves)
    moves.push(src + "->" + dst)
    hanoi(n - 1, via, dst, src, moves)
end
let moves = []
hanoi(3, "A", "C", "B", moves)
print("moves:", len(moves))
for (const auto& m : moves) {
    print(m)
}
