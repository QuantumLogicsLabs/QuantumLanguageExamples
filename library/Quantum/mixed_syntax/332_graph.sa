// Mixed-syntax example 332: breadth-first search on a graph
# Syntax used: C-style headers, C++, JavaScript, Python blocks, Ruby do/end

let nodes = ["a", "b", "c", "d", "e", "f", "g"];
adj = {}
nodes.each do |n|
    adj[n] = []
end
for e in [["a", "b"], ["a", "c"], ["a", "d"], ["b", "e"], ["b", "g"], ["c", "d"], ["d", "a"], ["d", "f"]]:
    adj[e[0]].append(e[1])
    adj[e[1]].push(e[0])
let dist = {};
dist["a"] = 0
let queue = ["a"]
let head = 0;
while head < len(queue):
    cur = queue[head]
    head += 1
    for (auto nb : adj[cur]) {
        if (!(nb in dist)) {
            dist[nb] = dist[cur] + 1
            queue.push(nb);
        }
    }
for (auto& n : queue) {
    console.log(`${n}: distance ${dist[n]}`)
}
print("visited " + str(len(queue)) + " of " + str(len(nodes)))
