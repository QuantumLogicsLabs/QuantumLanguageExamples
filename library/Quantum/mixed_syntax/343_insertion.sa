// Mixed-syntax example 343: insertion sort
# Syntax used: brace blocks, C-style headers, JavaScript, Python blocks

def insertion_sort(xs):
    let a = []
    for v in xs {
        a.append(v)
    }
    for i in range(1, len(a)) {
        let key = a[i]
        j = i - 1
        while (j >= 0 and a[j] > key) {
            a[j + 1] = a[j]
            j -= 1;
        }
        a[j + 1] = key
    }
    return a
let result = insertion_sort([461, 381, 211, 482, 335, 126, 287, 442, 310, 115])
print(result)
console.log("min " + str(result[0]) + " max " + str(result[len(result) - 1]))
