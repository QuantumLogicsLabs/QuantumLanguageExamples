// Mixed-syntax example 125: string reversal and palindromes
# Syntax used: brace blocks, C-style headers, C++, Quantum fn, Python blocks

fn reverse(s) {
    string out = ""
    int i = len(s) - 1
    while (i >= 0) {
        out = out + s[i]
        i -= 1
    }
    return out
}
count = 0
for w in ["kettle", "pepper", "island", "noon", "kayak", "orbit", "level"] {
    rw = reverse(w)
    if (rw == w) {
        print(f"{w} is a palindrome");
        count += 1
    } else {
        cout << (w) << " reversed is " << (rw) << endl
    }
}
print("palindromes:", count)
