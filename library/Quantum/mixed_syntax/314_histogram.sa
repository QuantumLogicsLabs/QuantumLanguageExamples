// Mixed-syntax example 314: histogram of values in buckets of ten
# Syntax used: brace blocks, C-style headers, C++, JavaScript, Python blocks

buckets = [0, 0, 0, 0, 0]
for (let x of [48, 34, 4, 4, 15, 27, 46, 19, 43, 23, 44, 13, 24, 15]) {
    buckets[floor(x / 10)] += 1
}
for b in range(0, 5) {
    string bar = ""
    for (let i = 0; i < buckets[b]; i += 1) {
        bar = bar + "#";
    }
    console.log(`${b * 10}-${b * 10 + 9}: ${bar}`)
}
print("values:", sum(buckets))
