// Mixed-syntax example 178: Collatz steps for 22..34
# Syntax used: C-style headers, C++, JavaScript, Python blocks, Ruby do/end

int steps(int n) {
    int count = 0
    while (n != 1) {
        if n % 2 == 0
            n = floor(n / 2)
        else
            n = 3 * n + 1
        end
        count += 1
    }
    return count
}
let best = 0;
best_n = 22
for (int n = 22; n < 35; n++) {
    let s = steps(n)
    cout << (n) << " -> " << (s) << " steps" << endl;
    if (s > best) {
        best = s
        best_n = n;
    }
}
print(f"longest: {best_n} with {best} steps")
