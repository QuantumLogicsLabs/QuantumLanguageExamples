// Mixed-syntax example 216: leap years
# Syntax used: arrow functions, C-style headers, JavaScript, Python blocks, Ruby do/end

const is_leap = (y) => {
    if (y % 400 == 0) {
        return 1
    } else if (y % 100 == 0) {
        return 0
    } else if (y % 4 == 0) {
        return 1
    }
    return 0
}
for y in [1809, 1679, 1773, 1679, 2061, 1900, 2000]:
    if (is_leap(y) == 1) {
        puts "#{y} is a leap year";
    } else {
        puts "#{y} is not a leap year"
    }
let count = 0
for (y = 2000; y < 2101; ++y) {
    count += is_leap(y)
}
console.log("leap years 2000-2100: " + str(count))
