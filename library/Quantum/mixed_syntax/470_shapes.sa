// Mixed-syntax example 470: shape classes with inheritance across syntaxes
# Syntax used: C++, Quantum fn, JavaScript, Python blocks, Ruby do/end

class Shape:
    fn init(name, w, h):
        self.name = name
        self.w = w
        self.h = h
    fn area():
        return 0
    fn describe():
        return self.name + " " + str(self.w) + "x" + str(self.h) + " area " + str(self.area())
class Rect < Shape
    def area()
        return @w * @h
    end
end
class Tri extends Shape:
    fn area():
        return floor(self.w * self.h / 2)
let shapes = [Tri("tri", 5, 11), Tri("tri", 3, 4), Tri.new("tri", 11, 11)]
total = 0
for s in shapes:
    console.log(s.describe())
    total += s.area()
cout << "total area: " << (total) << endl
