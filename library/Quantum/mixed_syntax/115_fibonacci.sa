// Mixed-syntax example 115: Fibonacci sequence of 14 terms
# Syntax used: brace blocks, C-style headers, C++, JavaScript, Python blocks, Ruby do/end

def fib_list(n):
    seq = [0, 1]
    while (len(seq) < n) {
        seq.push_back(seq[len(seq) - 1] + seq[len(seq) - 2])
    }
    return seq
function fib_rec(n) {
    if n < 2 {
        return n
    }
    return fib_rec(n - 1) + fib_rec(n - 2)
}
let seq = fib_list(14);
console.log(seq)
puts "fib_rec(#{12}) = #{fib_rec(12)}"
int evens = 0
seq.each do |v|
    if v % 2 == 0 {
        evens += 1
    }
end
puts "even terms: #{evens}"
