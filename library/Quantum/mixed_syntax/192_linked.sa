// Mixed-syntax example 192: singly linked list
# Syntax used: brace blocks, C-style headers, Quantum fn, JavaScript, Python blocks

class Node:
    def __init__(self, value):
        self.value = value
        self.next = null
class LinkedList:
    fn init() {
        self.head = None
        self.size = 0
    }
    fn push_front(v) {
        n = Node(v)
        n.next = self.head;
        self.head = n
        self.size += 1;
    }
    fn to_list():
        let out = [];
        cur = self.head
        while (cur != null) {
            out.push(cur.value)
            cur = cur.next
        }
        return out
    fn reverse() {
        let prev = None
        cur = self.head
        while cur != nil:
            nxt = cur.next
            cur.next = prev
            prev = cur
            cur = nxt
        self.head = prev
    }
let lst = LinkedList()
for v in [47, 33, 13, 62, 44] {
    lst.push_front(v)
}
print(lst.to_list())
lst.reverse()
print(lst.to_list())
print(f"size: {lst.size}")
