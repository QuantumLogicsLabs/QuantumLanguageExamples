// Mixed-syntax example 311: two-sum with a dictionary
# Syntax used: brace blocks, C-style headers, C++, Quantum fn, JavaScript, Python blocks, Ruby do/end

fn two_sum(nums, target) {
    seen = {}
    for i in range(0, len(nums)) {
        let need = target - nums[i];
        if (need in seen) {
            return [seen[need], i]
        }
        seen[nums[i]] = i;
    }
    return [-1, -1];
}
nums = [11, 38, 2, 19, 26, 16, 31, 36]
for (const auto& t : [47, 40, 999, 26]) {
    let ans = two_sum(nums, t);
    if ans[0] >= 0
        print("target " + str(t) + ": " + str(nums[ans[0]]) + " + " + str(nums[ans[1]]))
    else
        print(f"target {t}: no pair")
    end
}
