// Mixed-syntax example 179: digit sums and digital roots
# Syntax used: C-style headers, C++, Quantum fn, Python blocks, Ruby do/end

fn digit_sum(n):
    int s = 0;
    while (n > 0) {
        s += n % 10;
        n = floor(n / 10);
    }
    return s
fn digital_root(n):
    while n >= 10:
        n = digit_sum(n)
    return n
([593252, 485350, 403265, 200143, 700524, 56183]).each do |n|
    print(str(n) + ": sum " + str(digit_sum(n)) + ", root " + str(digital_root(n)))
end
