// Mixed-syntax example 220: breadth-first search on a graph
# Syntax used: brace blocks, C-style headers, C++, JavaScript, Python blocks, Ruby do/end

let nodes = ["a", "b", "c", "d", "e"];
let adj = {};
for n in nodes:
    adj[n] = []
for e in [["a", "b"], ["a", "c"], ["a", "d"], ["c", "d"], ["c", "e"]] {
    adj[e[0]].push(e[1])
    adj[e[1]].push_back(e[0])
}
dist = {}
dist["a"] = 0
let queue = ["a"]
head = 0
while (head < len(queue)) {
    cur = queue[head]
    head += 1
    for nb in adj[cur] {
        if not (nb in dist) {
            dist[nb] = dist[cur] + 1
            queue.append(nb);
        }
    }
}
queue.each do |n|
    cout << (n) << ": distance " << (dist[n]) << endl
end
print("visited", len(queue), "of", len(nodes))
