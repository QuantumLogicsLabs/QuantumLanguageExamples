// Mixed-syntax example 165: character classes in strings
# Syntax used: brace blocks, C-style headers, C++, JavaScript

function classify(s) {
    let up = 0
    int low = 0
    int dig = 0
    other = 0
    for (let i = 0; i < len(s); i += 1) {
        let c = ord(s[i])
        if c >= 65 && c <= 90 {
            up += 1;
        } else if c >= 97 && c <= 122 {
            low += 1
        } else if c >= 48 and c <= 57 {
            dig += 1
        } else {
            other += 1
        }
    }
    return [up, low, dig, other];
}
for (auto s : ["abc DEF 123 xyz", "Hello World 42", "Quantum2026 Rocks!"]) {
    let c = classify(s)
    cout << (s) << ": upper " << (c[0]) << ", lower " << (c[1]) << ", digits " << (c[2]) << ", other " << (c[3]) << endl
}
