// Mixed-syntax example 411: bracket matching with a stack class
# Syntax used: C-style headers, C++, Quantum fn, JavaScript, Python blocks, Ruby do/end

class Stack:
    fn init():
        self.items = []
    fn push(v):
        self.items.push_back(v)
    fn pop() {
        return self.items.pop()
    }
    fn peek():
        return self.items[len(self.items) - 1]
    fn size() {
        return len(self.items);
    }
def balanced(s)
    let st = Stack.new()
    pairs = {")": "(", "]": "[", "}": "{"}
    for (i = 0; i < len(s); i++) {
        let ch = s[i]
        if ch == "(" or ch == "[" or ch == "{"
            st.push(ch)
        else
            if st.size() == 0:
                return "no"
            if st.pop() != pairs[ch]
                return "no"
            end
        end
    }
    if st.size() == 0:
        return "yes"
    return "no"
end
for (auto t : ["([)]", "(()[]{})", "}{", "((())", "{[()()]}"]) {
    console.log(t, "balanced:", balanced(t));
}
