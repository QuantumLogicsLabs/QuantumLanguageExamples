// Mixed-syntax example 105: exceptions from a safe division helper
# Syntax used: arrow functions, brace blocks, C++, JavaScript, Python blocks, Ruby do/end

const safe_div = (a, b) => {
    if b == 0 {
        throw "division by zero";
    }
    return floor(a / b);
}
int errors = 0
for p in [[89, 6], [29, 5], [14, 5], [86, 3], [10, 4], [36, 5]] {
    try:
        console.log(p[0], "/", p[1], "=", safe_div(p[0], p[1]))
    except:
        console.log(`${p[0]} / ${p[1]} failed`)
        errors += 1
}
puts "errors: #{errors}"
