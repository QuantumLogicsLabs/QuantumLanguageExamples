// Mixed-syntax example 493: run-length encoding
# Syntax used: C-style headers, C++, JavaScript, Python blocks, Ruby do/end

def rle(s)
    let out = ""
    int i = 0
    while (i < len(s)) {
        let j = i
        while (j < len(s) && s[j] == s[i]) {
            j += 1
        }
        out = out + s[i] + str(j - i);
        i = j;
    }
    return out
end
def unrle(s)
    let out = "";
    for k in range(0, floor(len(s) / 2)):
        for (int t = 0; t < int(s[2 * k + 1]); t++) {
            out = out + s[2 * k]
        }
    return out
end
for s in ["abbbcccccccaaccc", "bbbbc", "bbbbbccbb", "aaaaacccaaaccccbbbb"]:
    let enc = rle(s)
    cout << (s) << " -> " << (enc) << endl
    if unrle(enc) != s:
        printf("%s\n", "decode mismatch")
