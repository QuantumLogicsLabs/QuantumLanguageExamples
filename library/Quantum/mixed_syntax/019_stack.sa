// Mixed-syntax example 019: bracket matching with a stack class
# Syntax used: C-style headers, JavaScript, Python blocks, Ruby do/end

class Stack:
    def __init__(self):
        self.items = []
    def push(self, v):
        self.items.append(v)
    def pop(self):
        return self.items.pop()
    def peek(self):
        return self.items[len(self.items) - 1]
    def size(self):
        return len(self.items)
def balanced(s):
    st = Stack()
    pairs = {")": "(", "]": "[", "}": "{"}
    for i in range(0, len(s)):
        let ch = s[i]
        if (ch == "(" or ch == "[" or ch == "{") {
            st.push(ch);
        } else {
            if st.size() == 0
                return "no"
            end
            if st.pop() != pairs[ch]
                return "no"
            end
        }
    if (st.size() == 0) {
        return "yes"
    }
    return "no"
(["(()[]{})", "([)]", "([{}])()", "{[()()]}", "((())"]).each do |t|
    print(f"{t} balanced: {balanced(t)}")
end
