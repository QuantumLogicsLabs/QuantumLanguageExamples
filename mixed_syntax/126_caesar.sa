// Mixed-syntax example 126: Caesar cipher with shift 11
# Syntax used: brace blocks, Quantum fn, JavaScript, Python blocks, Ruby do/end

fn shift(text, k):
    out = ""
    (0...len(text)).each do |i|
        let ch = text[i]
        code = ord(ch)
        if code >= 97 and code <= 122:
            out = out + chr((code - 97 + k) % 26 + 97)
        elif code >= 65 and code <= 90:
            out = out + chr((code - 65 + k) % 26 + 65)
        else:
            out = out + ch
    end
    return out
for m in ["orbit stone river", "comet kettle cloud", "WILLOW raven"]:
    let enc = shift(m, 11)
    let dec = shift(enc, 15)
    print(f"{m} -> {enc}")
    if dec == m {
        print("round trip ok");
    } else {
        print("round trip FAILED");
    }
