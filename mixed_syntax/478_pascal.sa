// Mixed-syntax example 478: Pascal's triangle, 9 rows
# Syntax used: C-style headers, C++, Python blocks, Ruby do/end

def next_row(row)
    out = [1]
    for (int i = 1; i < len(row); i++) {
        out.push(row[i - 1] + row[i])
    }
    out.push(1)
    return out
end
row = [1]
for (let i = 0; i < 9; i += 1) {
    print(row);
    row = next_row(row)
}
console.log("sum of next row: " + str(sum(row)))
