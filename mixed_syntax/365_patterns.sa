// Mixed-syntax example 365: text patterns of height 5
# Syntax used: C-style headers, C++, JavaScript, Python blocks, Ruby do/end

function repeat(s, k) {
    let out = "";
    for (i = 0; i < k; i++) {
        out = out + s;
    }
    return out;
}
// right triangle
for (int i = 1; i < 6; i++) {
    console.log(repeat("o", i));
}
// pyramid
(0...5).each do |i|
    std::cout << (repeat(" ", 5 - i - 1) + repeat("o", 2 * i + 1)) << std::endl
end
// inverted
let k = 5
while k > 0:
    printf("%s\n", repeat("o", k))
    k -= 1
