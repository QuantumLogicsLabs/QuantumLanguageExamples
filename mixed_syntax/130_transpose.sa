// Mixed-syntax example 130: transpose of a 4x3 matrix
# Syntax used: arrow functions, brace blocks, C++, JavaScript, Ruby do/end

let transpose = (m) => {
    out = []
    for j in range(0, len(m[0])) {
        col = []
        (0...len(m)).each do |i|
            col.push(m[i][j])
        end
        out.append(col);
    }
    return out
}
M = [[28, 34, 31], [33, 14, 34], [42, 3, 46], [47, 5, 34]]
T = transpose(M)
for (const auto& row : T) {
    console.log(row)
}
M.each do |row|
    puts "row sum #{sum(row)}"
end
