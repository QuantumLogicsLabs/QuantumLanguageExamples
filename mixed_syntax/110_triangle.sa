// Mixed-syntax example 110: triangle classification
# Syntax used: brace blocks, C++, Quantum fn, JavaScript

fn kind(a, b, c) {
    if a + b <= c or a + c <= b or b + c <= a {
        return "not a triangle";
    } else if a == b && b == c {
        return "equilateral"
    } else if a == b || b == c || a == c {
        return "isosceles";
    } else {
        return "scalene"
    }
}
for (const auto& t : [[2, 2, 3], [4, 3, 5], [3, 9, 6], [11, 7, 6], [9, 3, 6], [12, 12, 5]]) {
    console.log(`${t[0]}, ${t[1]}, ${t[2]}: ${kind(t[0], t[1], t[2])}`);
}
