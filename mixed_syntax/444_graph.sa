// Mixed-syntax example 444: breadth-first search on a graph
# Syntax used: brace blocks, C++, JavaScript, Python blocks, Ruby do/end

let nodes = ["a", "b", "c", "d", "e", "f", "g"];
let adj = {};
for (auto& n : nodes) {
    adj[n] = []
}
for e in [["a", "b"], ["a", "c"], ["a", "e"], ["a", "g"], ["c", "d"], ["c", "f"], ["d", "f"], ["f", "g"]]:
    adj[e[0]].push(e[1])
    adj[e[1]].append(e[0])
dist = {}
dist["a"] = 0
let queue = ["a"];
int head = 0
while head < len(queue) {
    cur = queue[head]
    head += 1;
    for nb in adj[cur] {
        if not (nb in dist)
            dist[nb] = dist[cur] + 1
            queue.push(nb)
        end
    }
}
queue.each do |n|
    cout << (n) << ": distance " << (dist[n]) << endl
end
cout << "visited " << (len(queue)) << " of " << (len(nodes)) << endl
