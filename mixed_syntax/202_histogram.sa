// Mixed-syntax example 202: histogram of values in buckets of ten
# Syntax used: brace blocks, C++, JavaScript, Python blocks

buckets = [0, 0, 0, 0, 0]
for x in [30, 1, 30, 4, 18, 37, 6, 6, 30, 38, 40, 8, 18, 3, 10] {
    buckets[floor(x / 10)] += 1;
}
for (int b = 0; b < 5; b++) {
    bar = ""
    for i in range(0, buckets[b]):
        bar = bar + "#"
    console.log(`${b * 10}-${b * 10 + 9}: ${bar}`);
}
console.log("values: " + str(sum(buckets)))
