// Mixed-syntax example 197: text patterns of height 5
# Syntax used: C-style headers, Quantum fn, JavaScript, Python blocks, Ruby do/end

fn repeat(s, k) {
    out = ""
    (0...k).each do |i|
        out = out + s
    end
    return out
}
# right triangle
for i in range(1, 6):
    print(repeat("+", i))
// pyramid
for (i = 0; i < 5; i += 1) {
    puts(repeat(" ", 5 - i - 1) + repeat("+", 2 * i + 1));
}
// inverted
k = 5
while k > 0
    console.log(repeat("+", k))
    k -= 1
end
