// Mixed-syntax example 157: run-length encoding
# Syntax used: brace blocks, C-style headers, C++, JavaScript, Python blocks, Ruby do/end

def rle(s):
    let out = ""
    let i = 0
    while i < len(s) {
        let j = i;
        while (j < len(s) and s[j] == s[i]) {
            j += 1;
        }
        out = out + s[i] + str(j - i)
        i = j
    }
    return out
def unrle(s):
    out = ""
    for k in range(0, floor(len(s) / 2)):
        (0...int(s[2 * k + 1])).each do |t|
            out = out + s[2 * k]
        end
    return out
for (auto s : ["cbbaa", "abb", "aabbbbaaaaaa", "ccbbbbaaacccc"]) {
    let enc = rle(s)
    console.log(s, "->", enc)
    if (unrle(enc) != s) {
        printf("%s\n", "decode mismatch");
    }
}
