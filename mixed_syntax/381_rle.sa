// Mixed-syntax example 381: run-length encoding
# Syntax used: C-style headers, Quantum fn, JavaScript, Python blocks, Ruby do/end

fn rle(s) {
    let out = ""
    let i = 0
    while i < len(s)
        j = i
        while (j < len(s) && s[j] == s[i]) {
            j += 1;
        }
        out = out + s[i] + str(j - i)
        i = j
    end
    return out;
}
def unrle(s)
    let out = ""
    for k in range(0, floor(len(s) / 2)):
        for t in range(0, int(s[2 * k + 1])):
            out = out + s[2 * k]
    return out
end
for s in ["bbbbaaacc", "ccbaa", "aaaacccbbbb", "bbbbbbbbaaaccc"]:
    enc = rle(s)
    print(f"{s} -> {enc}")
    if unrle(enc) != s:
        print("decode mismatch")
