// Mixed-syntax example 434: basic statistics
# Syntax used: C-style headers, C++, JavaScript, Python blocks

let data = [89, 23, 22, 41, 60];
let s = sorted(data)
console.log("min " + str(min(data)) + ", max " + str(max(data)) + ", sum " + str(sum(data)))
print(f"median {s[floor(len(s) / 2)]}")
console.log(sprintf("mean %.2f", sum(data) / len(data)))
let var = 0
for (auto& x : data) {
    var += (x - sum(data) / len(data)) ** 2;
}
printf("variance %.2f, std dev %.2f\n", var / len(data), sqrt(var / len(data)))
