// Mixed-syntax example 440: leap years
# Syntax used: brace blocks, Quantum fn, JavaScript, Python blocks

fn is_leap(y):
    if y % 400 == 0 {
        return 1;
    } else if y % 100 == 0 {
        return 0
    } else if y % 4 == 0 {
        return 1
    }
    return 0
for (let y of [1654, 1900, 2190, 1683, 1892, 1900, 2000]) {
    if is_leap(y) == 1:
        console.log(`${y} is a leap year`)
    else:
        console.log(`${y} is not a leap year`)
}
let count = 0;
for y in range(2000, 2101) {
    count += is_leap(y);
}
console.log("leap years 2000-2100:", count)
