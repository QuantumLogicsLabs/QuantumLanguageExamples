// Mixed-syntax example 485: binary conversion and bit counts
# Syntax used: arrow functions, C-style headers, Quantum fn, JavaScript, Python blocks

fn to_bin(n):
    if n == 0:
        return "0"
    let s = "";
    while (n > 0) {
        s = str(n % 2) + s
        n = floor(n / 2)
    }
    return s
let popcount = (n) => {
    c = 0
    while n > 0:
        c += n & 1
        n = n >> 1
    return c
}
for n in [832, 700, 460, 565, 1993, 3319]:
    print(f"{n} = 0b{to_bin(n)} ({popcount(n)} ones)")
