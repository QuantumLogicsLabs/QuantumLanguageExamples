// Mixed-syntax example 372: Roman numerals
# Syntax used: C-style headers, JavaScript, Python blocks, Ruby do/end

def to_roman(n):
    let vals = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1];
    let syms = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"];
    let out = ""
    (0...len(vals)).each do |i|
        while (n >= vals[i]) {
            out = out + syms[i]
            n -= vals[i];
        }
    end
    return out
([1224, 3906, 3812, 439, 2829, 1706]).each do |n|
    console.log(`${n} = ${to_roman(n)}`)
end
