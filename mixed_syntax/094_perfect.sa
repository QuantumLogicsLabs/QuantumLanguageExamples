// Mixed-syntax example 094: perfect, abundant and deficient numbers below 541
# Syntax used: brace blocks, C++, Quantum fn, JavaScript

fn divisor_sum(n):
    s = 0
    for d in range(1, n) {
        if n % d == 0 {
            s += d
        }
    }
    return s
perfect = []
let abundant = 0
let deficient = 0
for (int n = 2; n < 541; n++) {
    let s = divisor_sum(n)
    if s == n {
        perfect.append(n);
    } else if s > n {
        abundant += 1;
    } else {
        deficient += 1
    }
}
console.log(perfect)
console.log(`abundant: ${abundant}, deficient: ${deficient}`)
