// Mixed-syntax example 116: gcd and lcm of number pairs
# Syntax used: C++, Quantum fn, JavaScript, Python blocks

fn gcd(a, b) {
    while b != 0:
        t = b
        b = a % b
        a = t
    return a
}
fn lcm(a, b) {
    return floor(a * b / gcd(a, b));
}
let pairs = [[6, 69], [186, 152], [163, 9], [24, 142]]
for (auto& p : pairs) {
    console.log(`gcd(${p[0]}, ${p[1]}) = ${gcd(p[0], p[1])}, lcm = ${lcm(p[0], p[1])}`)
}
