// Mixed-syntax example 272: leap years
# Syntax used: brace blocks, JavaScript, Python blocks, Ruby do/end

function is_leap(y) {
    if y % 400 == 0 {
        return 1
    } else if y % 100 == 0 {
        return 0
    } else if y % 4 == 0 {
        return 1
    }
    return 0
}
for y in [2208, 2161, 1661, 2135, 1844, 1900, 2000]:
    if is_leap(y) == 1
        print(f"{y} is a leap year")
    else
        console.log(`${y} is not a leap year`)
    end
count = 0
for y in range(2000, 2101) {
    count += is_leap(y);
}
console.log("leap years 2000-2100: " + str(count))
