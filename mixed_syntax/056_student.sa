// Mixed-syntax example 056: students and courses (classes holding lists)
# Syntax used: brace blocks, C++, JavaScript, Ruby do/end

class Student {
    constructor(name) {
        this.name = name
        this.marks = []
    }
    add_mark(m) {
        this.marks.push_back(m)
    }
    average() {
        if len(this.marks) == 0 {
            return 0;
        }
        return floor(sum(this.marks) / len(this.marks))
    }
    best() {
        return max(this.marks);
    }
}
roster = []
(["Esme", "Dev", "Bram", "Ayla"]).each do |n|
    let s = new Student(n)
    for (int k = 0; k < 2; k++) {
        s.add_mark((len(n) * 7 + k * 5) % 41 + 60)
    }
    roster.push(s)
end
let top = roster[0]
roster.each do |s|
    console.log(str(s.name) + ": average " + str(s.average()) + ", best " + str(s.best()))
    if s.average() > top.average()
        top = s
    end
end
console.log(`top student: ${top.name}`)
