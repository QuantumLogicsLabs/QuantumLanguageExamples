// Mixed-syntax example 370: histogram of values in buckets of ten
# Syntax used: brace blocks, C++, JavaScript, Ruby do/end

buckets = [0, 0, 0, 0, 0]
([47, 20, 33, 14, 38, 20, 48, 5, 48, 49, 35, 29, 38, 34, 19, 49, 29, 49, 36]).each do |x|
    buckets[floor(x / 10)] += 1
end
for b in range(0, 5) {
    let bar = ""
    for (int i = 0; i < buckets[b]; i++) {
        bar = bar + "#";
    }
    cout << (b * 10) << "-" << (b * 10 + 9) << ": " << (bar) << endl
}
console.log(`values: ${sum(buckets)}`)
