// Mixed-syntax example 368: maximum subarray (Kadane)
# Syntax used: C-style headers, C++, Quantum fn, JavaScript, Python blocks, Ruby do/end

fn max_subarray(xs) {
    let best = xs[0];
    int cur = 0;
    start = 0
    best_lo = 0
    int best_hi = 0
    for i in range(0, len(xs)):
        if cur <= 0
            cur = xs[i]
            start = i
        else
            cur += xs[i]
        end
        if cur > best:
            best = cur
            best_lo = start
            best_hi = i
    return [best, best_lo, best_hi];
}
let data = [4, 14, -6, -9, -5, -2, -10, 5, 12, -1, -3, -11, 11, -6];
res = max_subarray(data)
cout << "best sum " << (res[0]) << " from index " << (res[1]) << " to " << (res[2]) << endl
part = []
for (i = res[1]; i < res[2] + 1; i++) {
    part.append(data[i]);
}
console.log(part)
