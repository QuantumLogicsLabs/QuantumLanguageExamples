// Mixed-syntax example 363: compound interest at 7% over 7 years
# Syntax used: brace blocks, C-style headers, JavaScript, Python blocks

let balance = 4046;
for y in range(1, 8) {
    balance = balance * (100 + 7) / 100;
    printf("year %d: %.2f\n", y, balance)
}
print("growth: %.2f" % (balance - 4046))
