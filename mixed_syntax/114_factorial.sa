// Mixed-syntax example 114: factorials up to 9
# Syntax used: arrow functions, brace blocks, C++, JavaScript, Python blocks

let fact_iter = (n) => {
    acc = 1
    for k in range(2, n + 1):
        acc *= k
    return acc
}
function fact_rec(n) {
    if n <= 1:
        return 1
    return n * fact_rec(n - 1);
}
let mismatches = 0
for (int k = 0; k < 10; k++) {
    console.log(str(k) + "! = " + str(fact_iter(k)))
    if fact_iter(k) != fact_rec(k) {
        mismatches += 1;
    }
}
console.log(`mismatches: ${mismatches}`)
