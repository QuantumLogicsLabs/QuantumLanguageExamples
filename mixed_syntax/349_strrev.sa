// Mixed-syntax example 349: string reversal and palindromes
# Syntax used: C-style headers, C++, JavaScript, Python blocks, Ruby do/end

def reverse(s):
    let out = "";
    int i = len(s) - 1
    while (i >= 0) {
        out = out + s[i];
        i -= 1;
    }
    return out
count = 0
for (auto& w : ["pepper", "civic", "quartz", "noon", "tenet", "ember", "meadow"]) {
    rw = reverse(w)
    if rw == w
        puts "#{w} is a palindrome"
        count += 1
    else
        print(f"{w} reversed is {rw}")
    end
}
console.log("palindromes:", count)
