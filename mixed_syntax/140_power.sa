// Mixed-syntax example 140: fast modular exponentiation
# Syntax used: brace blocks, C++, JavaScript, Ruby do/end

function power_mod(b, e, m) {
    int result = 1;
    b = b % m
    while e > 0 {
        if e % 2 == 1 {
            result = result * b % m
        }
        b = b * b % m
        e = floor(e / 2)
    }
    return result
}
([[9, 0, 7], [2, 10, 1009], [5, 21, 7], [7, 23, 1009], [2, 1, 1000]]).each do |c|
    console.log(`${c[0]}^${c[1]} mod ${c[2]} = ${power_mod(c[0], c[1], c[2])}`)
end
