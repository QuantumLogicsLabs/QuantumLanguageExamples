// Mixed-syntax example 258: histogram of values in buckets of ten
# Syntax used: C-style headers, JavaScript, Python blocks, Ruby do/end

let buckets = [0, 0, 0, 0, 0]
([7, 28, 2, 35, 16, 39, 25, 24, 6, 36]).each do |x|
    buckets[floor(x / 10)] += 1
end
for (int b = 0; b < 5; b += 1) {
    bar = ""
    for i in range(0, buckets[b]):
        bar = bar + "#"
    console.log(`${b * 10}-${b * 10 + 9}: ${bar}`)
}
console.log(`values: ${sum(buckets)}`)
