// Mixed-syntax example 352: word frequency count
# Syntax used: C++, JavaScript, Python blocks, Ruby do/end

string text = "jungle grape tiger jungle grape island tiger tiger island grape grape jungle jungle tiger"
words = text.split(" ")
let freq = {};
let order = []
for (const w of words) {
    if w in freq
        freq[w] += 1
    else
        freq[w] = 1
        order.push(w)
    end
}
for (const w of order) {
    cout << (w) << ": " << (freq[w]) << endl
}
let top = order[0]
for (let w of order) {
    if freq[w] > freq[top]:
        top = w
}
console.log("most common: " + str(top) + " (" + str(freq[top]) + ")")
