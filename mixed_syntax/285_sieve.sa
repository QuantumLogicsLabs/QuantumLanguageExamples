// Mixed-syntax example 285: prime sieve up to 66
# Syntax used: brace blocks, C-style headers, C++, Quantum fn, JavaScript, Python blocks, Ruby do/end

fn sieve(n):
    let flags = []
    for (int i = 0; i < n + 1; i++) {
        flags.push(1)
    }
    flags[0] = 0
    flags[1] = 0
    for (int p = 2; p < n + 1; ++p) {
        if flags[p] == 1
            let m = p * p
            while m <= n
                flags[m] = 0
                m += p
            end
        end
    }
    let primes = [];
    for i in range(2, n + 1) {
        if flags[i] == 1
            primes.append(i)
        end
    }
    return primes
let primes = sieve(66)
print(primes)
print("count: " + str(len(primes)) + ", largest: " + str(primes[len(primes) - 1]))
int twins = 0
for i in range(1, len(primes)):
    if primes[i] - primes[i - 1] == 2
        twins += 1
    end
print("twin pairs:", twins)
