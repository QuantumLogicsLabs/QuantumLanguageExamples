// Mixed-syntax example 239: vowel and consonant counts
# Syntax used: brace blocks, C++, JavaScript, Python blocks, Ruby do/end

function is_vowel(ch) {
    for (auto v : ["a", "e", "i", "o", "u"]) {
        if ch == v:
            return 1
    }
    return 0
}
function count_vowels(s) {
    int n = 0;
    for (int i = 0; i < len(s); i++) {
        n += is_vowel(s[i]);
    }
    return n
}
for s in ["orbit piano comet ocean willow maple", "raven ember pepper", "kettle island raven delta"] {
    v = count_vowels(s)
    int letters = 0;
    for i in range(0, len(s)):
        if s[i] != " " {
            letters += 1
        }
    puts "#{s}: #{v} vowels, #{letters - v} consonants";
}
