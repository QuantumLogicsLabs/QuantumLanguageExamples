// Mixed-syntax example 449: FooBar up to 24
# Syntax used: C-style headers, C++, Python blocks, Ruby do/end

def label(i)
    if i % 2 == 0 and i % 7 == 0
        return "FooBar"
    elsif i % 2 == 0
        return "Foo"
    elsif i % 7 == 0
        return "Bar"
    end
    return str(i)
end
special = 0
for i in range(1, 25):
    puts label(i)
    if (label(i) != str(i)) {
        special += 1
    }
cout << "special values: " << (special) << endl
