// Mixed-syntax example 341: prime sieve up to 147
# Syntax used: brace blocks, C++, Quantum fn, JavaScript, Python blocks, Ruby do/end

fn sieve(n) {
    flags = []
    for (int i = 0; i < n + 1; i++) {
        flags.append(1);
    }
    flags[0] = 0;
    flags[1] = 0;
    for p in range(2, n + 1) {
        if flags[p] == 1:
            let m = p * p;
            while m <= n {
                flags[m] = 0
                m += p
            }
    }
    primes = []
    for i in range(2, n + 1):
        if flags[i] == 1 {
            primes.push_back(i);
        }
    return primes;
}
primes = sieve(147)
print(primes)
print(f"count: {len(primes)}, largest: {primes[len(primes) - 1]}")
twins = 0
for i in range(1, len(primes)) {
    if primes[i] - primes[i - 1] == 2
        twins += 1
    end
}
cout << "twin pairs: " << (twins) << endl
