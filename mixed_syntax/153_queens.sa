// Mixed-syntax example 153: N-queens solutions for n = 4..4
# Syntax used: arrow functions, brace blocks, C-style headers, C++, Quantum fn, Python blocks

fn safe(cols, row, col):
    for (int r = 0; r < row; ++r) {
        c = cols[r]
        if (c == col || abs(c - col) == row - r) {
            return 0
        }
    }
    return 1
const solve = (cols, row, n) => {
    if (row == n) {
        return 1
    }
    count = 0
    for (int col = 0; col < n; col++) {
        if safe(cols, row, col) == 1:
            cols[row] = col
            count += solve(cols, row + 1, n)
    }
    return count
}
for n in range(4, 5) {
    cols = []
    for (int i = 0; i < n; i++) {
        cols.push(0);
    }
    print(f"{n} queens: {solve(cols, 0, n)} solutions");
}
