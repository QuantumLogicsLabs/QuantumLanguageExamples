// Mixed-syntax example 309: text patterns of height 4
# Syntax used: brace blocks, C-style headers, C++, Quantum fn, JavaScript

fn repeat(s, k):
    let out = "";
    for (int i = 0; i < k; i++) {
        out = out + s
    }
    return out
// right triangle
for (int i = 1; i < 5; i++) {
    printf("%s\n", repeat("#", i))
}
# pyramid
for (i = 0; i < 4; i++) {
    console.log(repeat(" ", 4 - i - 1) + repeat("#", 2 * i + 1));
}
# inverted
k = 4
while k > 0 {
    printf("%s\n", repeat("#", k));
    k -= 1;
}
