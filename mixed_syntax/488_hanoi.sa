// Mixed-syntax example 488: Towers of Hanoi with 2 disks
# Syntax used: brace blocks, JavaScript, Python blocks, Ruby do/end

def hanoi(n, src, dst, via, moves)
    if n == 0 {
        return;
    }
    hanoi(n - 1, src, via, dst, moves)
    moves.append(src + "->" + dst)
    hanoi(n - 1, via, dst, src, moves)
end
moves = []
hanoi(2, "A", "C", "B", moves)
print("moves:", len(moves))
moves.each do |m|
    console.log(m)
end
