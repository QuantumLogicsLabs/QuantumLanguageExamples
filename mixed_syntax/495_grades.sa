// Mixed-syntax example 495: grade classification
# Syntax used: brace blocks, JavaScript, Python blocks, Ruby do/end

def grade(s):
    if s >= 90 {
        return "A";
    } else if s >= 80 {
        return "B";
    } else if s >= 70 {
        return "C";
    } else if s >= 60 {
        return "D";
    } else {
        return "F"
    }
let names = ["fin", "gia", "ivy", "ali", "hen"]
let scores = [88, 87, 54, 36, 44];
tally = {"A": 0, "B": 0, "C": 0, "D": 0, "F": 0}
(0...len(names)).each do |i|
    g = grade(scores[i])
    tally[g] += 1
    console.log(str(names[i]) + ": " + str(scores[i]) + " -> " + str(g))
end
for g in ["A", "B", "C", "D", "F"] {
    console.log(str(g) + ": " + str(tally[g]));
}
