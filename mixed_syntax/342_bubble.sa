// Mixed-syntax example 342: bubble sort
# Syntax used: brace blocks, JavaScript, Python blocks, Ruby do/end

function bubble_sort(xs) {
    let a = []
    for v in xs {
        a.push(v);
    }
    n = len(a)
    for i in range(0, n) {
        swapped = 0
        for j in range(0, n - i - 1):
            if a[j] > a[j + 1]
                t = a[j]
                a[j] = a[j + 1]
                a[j + 1] = t
                swapped = 1
            end
        if swapped == 0:
            break
    }
    return a
}
let data = [38, 25, 2, 29, 17, 54, 87, 83]
let result = bubble_sort(data)
print(data)
print(result)
if result == sorted(data)
    console.log("sorted correctly")
else
    puts("wrong order")
end
