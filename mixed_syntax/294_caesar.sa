// Mixed-syntax example 294: Caesar cipher with shift 12
# Syntax used: C-style headers, C++, Quantum fn, JavaScript

fn shift(text, k) {
    out = ""
    for (int i = 0; i < len(text); i++) {
        ch = text[i]
        code = ord(ch)
        if (code >= 97 && code <= 122) {
            out = out + chr((code - 97 + k) % 26 + 97)
        } else if (code >= 65 && code <= 90) {
            out = out + chr((code - 65 + k) % 26 + 65)
        } else {
            out = out + ch;
        }
    }
    return out;
}
for (let m of ["raven island cloud", "apple grape meadow", "LANTERN comet"]) {
    enc = shift(m, 12)
    let dec = shift(enc, 14)
    console.log(`${m} -> ${enc}`);
    if (dec == m) {
        cout << ("round trip ok") << endl;
    } else {
        console.log("round trip FAILED")
    }
}
