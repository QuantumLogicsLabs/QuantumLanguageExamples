// Mixed-syntax example 086: Pascal's triangle, 7 rows
# Syntax used: arrow functions, C-style headers, C++, JavaScript

const next_row = (row) => {
    out = [1]
    for (int i = 1; i < len(row); i++) {
        out.append(row[i - 1] + row[i]);
    }
    out.push_back(1);
    return out
}
row = [1]
for (let i = 0; i < 7; i++) {
    console.log(row)
    row = next_row(row)
}
cout << "sum of next row: " << (sum(row)) << endl
