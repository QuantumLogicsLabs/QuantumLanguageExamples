// Mixed-syntax example 366: Pascal's triangle, 6 rows
# Syntax used: arrow functions, brace blocks, JavaScript, Python blocks

let next_row = (row) => {
    out = [1]
    for i in range(1, len(row)):
        out.push(row[i - 1] + row[i])
    out.push(1)
    return out
}
row = [1]
for i in range(0, 6) {
    console.log(row)
    row = next_row(row)
}
print(f"sum of next row: {sum(row)}")
