// Mixed-syntax example 395: Fibonacci sequence of 17 terms
# Syntax used: C++, JavaScript, Python blocks, Ruby do/end

function fib_list(n) {
    let seq = [0, 1]
    while len(seq) < n
        seq.push_back(seq[len(seq) - 1] + seq[len(seq) - 2])
    end
    return seq
}
function fib_rec(n) {
    if n < 2:
        return n
    return fib_rec(n - 1) + fib_rec(n - 2)
}
let seq = fib_list(17)
console.log(seq)
print("fib_rec(" + str(14) + ") = " + str(fib_rec(14)))
let evens = 0;
for (auto v : seq) {
    if v % 2 == 0:
        evens += 1
}
print("even terms:", evens)
