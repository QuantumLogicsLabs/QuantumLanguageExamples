// Mixed-syntax example 084: fast modular exponentiation
# Syntax used: brace blocks, Quantum fn, JavaScript, Python blocks

fn power_mod(b, e, m) {
    result = 1
    b = b % m
    while e > 0 {
        if e % 2 == 1:
            result = result * b % m
        b = b * b % m;
        e = floor(e / 2)
    }
    return result
}
for c in [[8, 1, 97], [4, 20, 97], [9, 0, 7], [7, 21, 7], [4, 11, 7]]:
    console.log(`${c[0]}^${c[1]} mod ${c[2]} = ${power_mod(c[0], c[1], c[2])}`)
