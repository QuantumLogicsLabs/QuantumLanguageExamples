// Mixed-syntax example 489: N-queens solutions for n = 4..4
# Syntax used: brace blocks, C++, Quantum fn, JavaScript, Python blocks, Ruby do/end

fn safe(cols, row, col):
    for (int r = 0; r < row; r++) {
        c = cols[r]
        if c == col or abs(c - col) == row - r {
            return 0
        }
    }
    return 1
fn solve(cols, row, n):
    if row == n {
        return 1
    }
    count = 0
    for (int col = 0; col < n; col++) {
        if safe(cols, row, col) == 1:
            cols[row] = col
            count += solve(cols, row + 1, n)
    }
    return count
for n in range(4, 5):
    let cols = []
    (0...n).each do |i|
        cols.append(0)
    end
    console.log(n, "queens:", solve(cols, 0, n), "solutions")
