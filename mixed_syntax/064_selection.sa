// Mixed-syntax example 064: selection sort (descending)
# Syntax used: brace blocks, C++, JavaScript, Python blocks, Ruby do/end

function selection_sort_desc(xs) {
    let a = [];
    for v in xs:
        a.append(v)
    (0...len(a)).each do |i|
        int best = i;
        for j in range(i + 1, len(a)):
            if a[j] > a[best] {
                best = j
            }
        if best != i {
            let t = a[i]
            a[i] = a[best]
            a[best] = t
        }
    end
    return a
}
result = selection_sort_desc([53, 11, 60, 5, 5, 21, 18, 21, 49])
console.log(result)
puts "top three: #{result[0]}, #{result[1]}, #{result[2]}"
