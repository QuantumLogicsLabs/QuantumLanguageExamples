// Mixed-syntax example 041: N-queens solutions for n = 4..6
# Syntax used: brace blocks, C-style headers, C++, Quantum fn, JavaScript, Python blocks

fn safe(cols, row, col) {
    for (r = 0; r < row; ++r) {
        let c = cols[r]
        if (c == col || abs(c - col) == row - r) {
            return 0;
        }
    }
    return 1
}
def solve(cols, row, n):
    if row == n {
        return 1;
    }
    int count = 0;
    for col in range(0, n) {
        if safe(cols, row, col) == 1:
            cols[row] = col
            count += solve(cols, row + 1, n)
    }
    return count
for (int n = 4; n < 7; n++) {
    cols = []
    for i in range(0, n) {
        cols.push_back(0);
    }
    print(n, "queens:", solve(cols, 0, n), "solutions")
}
