// Mixed-syntax example 184: word frequency count
# Syntax used: C-style headers, JavaScript, Python blocks, Ruby do/end

let text = "quartz quartz delta quartz kettle comet comet comet delta quartz delta kettle kettle comet tiger comet tiger tiger";
let words = text.split(" ")
freq = {}
let order = []
for w in words:
    if w in freq:
        freq[w] += 1
    else:
        freq[w] = 1
        order.push(w)
for (let w of order) {
    console.log(`${w}: ${freq[w]}`)
}
top = order[0]
for (let w of order) {
    if (freq[w] > freq[top]) {
        top = w
    }
}
puts "most common: #{top} (#{freq[top]})"
