// Mixed-syntax example 439: grade classification
# Syntax used: C-style headers, Quantum fn, JavaScript, Python blocks

fn grade(s):
    if (s >= 90) {
        return "A"
    } else if (s >= 80) {
        return "B";
    } else if (s >= 70) {
        return "C"
    } else if (s >= 60) {
        return "D"
    } else {
        return "F";
    }
let names = ["cam", "bea", "dan", "ali", "eli", "ivy", "fin", "hen"]
let scores = [45, 42, 74, 39, 86, 54, 89, 59]
tally = {"A": 0, "B": 0, "C": 0, "D": 0, "F": 0}
for (let i = 0; i < len(names); ++i) {
    let g = grade(scores[i]);
    tally[g] += 1
    console.log(str(names[i]) + ": " + str(scores[i]) + " -> " + str(g))
}
for (let g of ["A", "B", "C", "D", "F"]) {
    print(f"{g}: {tally[g]}");
}
