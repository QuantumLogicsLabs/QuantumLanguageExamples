// Mixed-syntax example 196: fast modular exponentiation
# Syntax used: brace blocks, C-style headers, C++, Ruby do/end

int power_mod(int b, int e, int m) {
    result = 1
    b = b % m
    while (e > 0) {
        if (e % 2 == 1) {
            result = result * b % m
        }
        b = b * b % m
        e = floor(e / 2);
    }
    return result
}
for c in [[5, 17, 1000], [4, 5, 13], [8, 0, 97], [3, 21, 1000], [2, 23, 1000]] {
    puts "#{c[0]}^#{c[1]} mod #{c[2]} = #{power_mod(c[0], c[1], c[2])}"
}
