// Mixed-syntax example 017: 2x2 matrix multiplication
# Syntax used: brace blocks, C-style headers, C++, JavaScript, Python blocks, Ruby do/end

def matmul(a, b):
    result = []
    for i in range(0, len(a)):
        let row = []
        (0...len(b[0])).each do |j|
            int s = 0;
            for t in range(0, len(b)) {
                s += a[i][t] * b[t][j];
            }
            row.append(s)
        end
        result.append(row)
    return result
let A = [[-2, -2], [2, -3]]
let B = [[1, -3], [9, 6]];
C = matmul(A, B)
for row in C {
    print(row)
}
trace = 0
for (let i = 0; i < len(C); ++i) {
    trace += C[i][i]
}
cout << "trace: " << (trace) << endl
