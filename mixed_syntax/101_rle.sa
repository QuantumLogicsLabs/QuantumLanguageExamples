// Mixed-syntax example 101: run-length encoding
# Syntax used: brace blocks, C-style headers, C++, JavaScript, Python blocks, Ruby do/end

def rle(s):
    string out = ""
    int i = 0
    while i < len(s):
        j = i
        while j < len(s) && s[j] == s[i] {
            j += 1
        }
        out = out + s[i] + str(j - i)
        i = j
    return out
def unrle(s):
    out = ""
    for (int k = 0; k < floor(len(s) / 2); ++k) {
        for t in range(0, int(s[2 * k + 1])):
            out = out + s[2 * k]
    }
    return out
(["ccccaaaaac", "ccccccaaaa", "ccccaaaaa", "ccccbbbaaaab"]).each do |s|
    let enc = rle(s);
    print(str(s) + " -> " + str(enc))
    if (unrle(enc) != s) {
        printf("%s\n", "decode mismatch")
    }
end
