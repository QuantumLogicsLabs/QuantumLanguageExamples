// Mixed-syntax example 104: leap years
# Syntax used: brace blocks, C++, JavaScript, Python blocks

function is_leap(y) {
    if y % 400 == 0 {
        return 1
    } else if y % 100 == 0 {
        return 0;
    } else if y % 4 == 0 {
        return 1
    }
    return 0;
}
for y in [2381, 2040, 1954, 2154, 1927, 1900, 2000]:
    if is_leap(y) == 1:
        print(y, "is a leap year")
    else:
        console.log(str(y) + " is not a leap year")
let count = 0;
for (int y = 2000; y < 2101; y++) {
    count += is_leap(y);
}
print("leap years 2000-2100: " + str(count))
