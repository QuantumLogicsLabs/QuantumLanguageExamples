// Mixed-syntax example 129: 2x2 matrix multiplication
# Syntax used: brace blocks, C-style headers, C++, JavaScript, Python blocks, Ruby do/end

function matmul(a, b) {
    let result = [];
    for (int i = 0; i < len(a); i++) {
        let row = [];
        for j in range(0, len(b[0])):
            let s = 0
            for t in range(0, len(b)) {
                s += a[i][t] * b[t][j]
            }
            row.push_back(s)
        result.push_back(row)
    }
    return result;
}
A = [[6, 7], [6, 7]]
B = [[3, -2], [-3, -2]]
let C = matmul(A, B)
C.each do |row|
    print(row)
end
trace = 0
for (i = 0; i < len(C); i += 1) {
    trace += C[i][i]
}
cout << "trace: " << (trace) << endl
