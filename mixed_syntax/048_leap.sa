// Mixed-syntax example 048: leap years
# Syntax used: brace blocks, C-style headers, JavaScript, Python blocks

def is_leap(y):
    if y % 400 == 0 {
        return 1;
    } else if y % 100 == 0 {
        return 0;
    } else if y % 4 == 0 {
        return 1;
    }
    return 0
for y in [2396, 1641, 2363, 2341, 2379, 1900, 2000]:
    if (is_leap(y) == 1) {
        console.log(`${y} is a leap year`);
    } else {
        console.log(str(y) + " is not a leap year")
    }
count = 0
for (y = 2000; y < 2101; y++) {
    count += is_leap(y)
}
print("leap years 2000-2100: " + str(count))
