// Mixed-syntax example 195: compound interest at 7% over 8 years
# Syntax used: brace blocks, C-style headers, JavaScript, Python blocks

let balance = 3998;
for y in range(1, 9) {
    balance = balance * (100 + 7) / 100;
    printf("year %d: %.2f\n", y, balance)
}
print("growth: %.2f" % (balance - 3998))
