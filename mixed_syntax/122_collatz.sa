// Mixed-syntax example 122: Collatz steps for 15..22
# Syntax used: C-style headers, C++, Python blocks, Ruby do/end

def steps(n):
    count = 0
    while n != 1
        if (n % 2 == 0) {
            n = floor(n / 2)
        } else {
            n = 3 * n + 1;
        }
        count += 1
    end
    return count
best = 0
best_n = 15
for n in range(15, 23):
    s = steps(n)
    cout << (n) << " -> " << (s) << " steps" << endl
    if (s > best) {
        best = s;
        best_n = n
    }
print(f"longest: {best_n} with {best} steps")
