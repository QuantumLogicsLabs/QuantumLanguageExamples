// Mixed-syntax example 301: bank account with overdraft errors
# Syntax used: C++, Quantum fn, JavaScript, Ruby do/end

class Account:
    fn init(owner, balance):
        self.owner = owner
        self.balance = balance
        self.log = []
    fn deposit(amount) {
        self.balance += amount;
        self.log.push_back("+" + str(amount))
    }
    fn withdraw(amount):
        if amount > self.balance
            throw "insufficient funds"
        end
        self.balance -= amount
        self.log.push("-" + str(amount))
    fn report() {
        return self.owner + " has " + str(self.balance);
    }
acct = Account.new("ada", 75)
int failed = 0;
for (let op of [["withdraw", 68], ["deposit", 24], ["withdraw", 220], ["deposit", 180], ["withdraw", 145], ["deposit", 163], ["withdraw", 161]]) {
    begin
        if op[0] == "deposit"
            acct.deposit(op[1])
        else
            acct.withdraw(op[1])
        end
        console.log(`${op[0]} ${op[1]} ok`)
    rescue
        console.log(`${op[0]} ${op[1]} refused`)
        failed += 1
    end
}
std::cout << acct.report() << std::endl
console.log(`refused operations: ${failed}, log size: ${len(acct.log)}`)
