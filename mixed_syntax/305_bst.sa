// Mixed-syntax example 305: binary search tree
# Syntax used: C-style headers, JavaScript, Python blocks, Ruby do/end

class TreeNode {
    constructor(key) {
        this.key = key
        this.left = nil
        this.right = nil;
    }
}
function insert(node, key) {
    if (node == nil) {
        return TreeNode(key);
    }
    if (key < node.key) {
        node.left = insert(node.left, key);
    } else {
        node.right = insert(node.right, key);
    }
    return node
}
def inorder(node, out)
    if node != null
        inorder(node.left, out)
        out.push(node.key)
        inorder(node.right, out)
    end
end
def height(node):
    if (node == nil) {
        return 0
    }
    return 1 + max(height(node.left), height(node.right))
let root = nil
for k in [60, 81, 67, 71, 30, 62, 43, 36, 44]:
    root = insert(root, k)
let keys = []
inorder(root, keys)
console.log(keys)
puts "height: #{height(root)}, root: #{root.key}"
