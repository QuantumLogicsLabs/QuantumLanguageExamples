// Mixed-syntax example 117: prime sieve up to 58
# Syntax used: brace blocks, C-style headers, C++, JavaScript, Python blocks, Ruby do/end

def sieve(n):
    flags = []
    for (let i = 0; i < n + 1; i += 1) {
        flags.push(1);
    }
    flags[0] = 0
    flags[1] = 0
    for p in range(2, n + 1) {
        if (flags[p] == 1) {
            int m = p * p
            while m <= n:
                flags[m] = 0
                m += p
        }
    }
    let primes = [];
    for (int i = 2; i < n + 1; i += 1) {
        if flags[i] == 1:
            primes.push_back(i)
    }
    return primes
let primes = sieve(58)
console.log(primes)
cout << "count: " << (len(primes)) << ", largest: " << (primes[len(primes) - 1]) << endl
let twins = 0
for (int i = 1; i < len(primes); i++) {
    if primes[i] - primes[i - 1] == 2
        twins += 1
    end
}
print(f"twin pairs: {twins}")
