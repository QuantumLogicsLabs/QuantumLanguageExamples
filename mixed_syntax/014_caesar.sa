// Mixed-syntax example 014: Caesar cipher with shift 17
# Syntax used: arrow functions, C-style headers, JavaScript, Python blocks, Ruby do/end

let shift = (text, k) => {
    let out = ""
    for i in range(0, len(text)):
        ch = text[i]
        let code = ord(ch);
        if code >= 97 and code <= 122
            out = out + chr((code - 97 + k) % 26 + 97)
        elsif code >= 65 and code <= 90
            out = out + chr((code - 65 + k) % 26 + 65)
        else
            out = out + ch
        end
    return out
}
(["maple ember willow", "harbor apple river", "TIMBER ember"]).each do |m|
    let enc = shift(m, 17);
    dec = shift(enc, 9)
    console.log(`${m} -> ${enc}`)
    if (dec == m) {
        print("round trip ok")
    } else {
        console.log("round trip FAILED")
    }
end
