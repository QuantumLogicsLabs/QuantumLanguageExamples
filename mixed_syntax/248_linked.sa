// Mixed-syntax example 248: singly linked list
# Syntax used: brace blocks, C++, JavaScript, Python blocks, Ruby do/end

class Node
    attr_accessor :next, :value
    def initialize(value)
        @value = value
        @next = nil
    end
end
class LinkedList:
    def __init__(self):
        self.head = nil
        self.size = 0
    def push_front(self, v):
        n = Node(v)
        n.next = self.head
        self.head = n
        self.size += 1
    def to_list(self):
        out = []
        let cur = self.head
        while cur != None
            out.append(cur.value)
            cur = cur.next
        end
        return out
    def reverse(self):
        prev = nil
        cur = self.head
        while cur != None {
            nxt = cur.next
            cur.next = prev
            prev = cur
            cur = nxt
        }
        self.head = prev
let lst = new LinkedList()
for v in [19, 1, 34, 93, 74, 10]:
    lst.push_front(v)
print(lst.to_list())
lst.reverse()
print(lst.to_list())
cout << "size: " << (lst.size) << endl
