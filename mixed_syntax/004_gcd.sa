// Mixed-syntax example 004: gcd and lcm of number pairs
# Syntax used: arrow functions, JavaScript, Python blocks, Ruby do/end

def gcd(a, b):
    while b != 0
        t = b
        b = a % b
        a = t
    end
    return a
const lcm = (a, b) => {
    return floor(a * b / gcd(a, b));
}
let pairs = [[169, 139], [111, 7], [49, 30], [8, 84], [55, 139]]
for p in pairs:
    console.log(`gcd(${p[0]}, ${p[1]}) = ${gcd(p[0], p[1])}, lcm = ${lcm(p[0], p[1])}`)
