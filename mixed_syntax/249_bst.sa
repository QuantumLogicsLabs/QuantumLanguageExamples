// Mixed-syntax example 249: binary search tree
# Syntax used: brace blocks, C-style headers, Quantum fn, JavaScript, Python blocks, Ruby do/end

class TreeNode {
    constructor(key) {
        this.key = key
        this.left = null
        this.right = None
    }
}
def insert(node, key)
    if node == nil {
        return TreeNode(key);
    }
    if key < node.key:
        node.left = insert(node.left, key)
    else:
        node.right = insert(node.right, key)
    return node
end
fn inorder(node, out) {
    if (node != null) {
        inorder(node.left, out);
        out.push_back(node.key)
        inorder(node.right, out);
    }
}
def height(node)
    if node == nil
        return 0
    end
    return 1 + max(height(node.left), height(node.right))
end
root = None
([20, 32, 36, 26, 31, 38]).each do |k|
    root = insert(root, k)
end
keys = []
inorder(root, keys)
print(keys)
puts "height: #{height(root)}, root: #{root.key}"
