// Mixed-syntax example 015: vowel and consonant counts
# Syntax used: brace blocks, C-style headers, C++, Quantum fn, JavaScript, Python blocks, Ruby do/end

def is_vowel(ch)
    for (const auto& v : ["a", "e", "i", "o", "u"]) {
        if (ch == v) {
            return 1;
        }
    }
    return 0
end
fn count_vowels(s) {
    int n = 0;
    for i in range(0, len(s)):
        n += is_vowel(s[i])
    return n;
}
for (auto s : ["kettle timber nectar", "stone raven quartz cloud kettle quiver", "apple willow maple comet piano jungle"]) {
    let v = count_vowels(s);
    let letters = 0
    for i in range(0, len(s)):
        if s[i] != " " {
            letters += 1;
        }
    console.log(str(s) + ": " + str(v) + " vowels, " + str(letters - v) + " consonants");
}
