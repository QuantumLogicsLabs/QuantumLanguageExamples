// Mixed-syntax example 441: exceptions from a safe division helper
# Syntax used: C-style headers, JavaScript, Python blocks, Ruby do/end

function safe_div(a, b) {
    if (b == 0) {
        raise "division by zero"
    }
    return floor(a / b);
}
errors = 0
for (const p of [[16, 0], [17, 0], [34, 3], [62, 0], [91, 7], [31, 7]]) {
    begin
        puts "#{p[0]} / #{p[1]} = #{safe_div(p[0], p[1])}"
    rescue StandardError => e
        puts "#{p[0]} / #{p[1]} failed"
        errors += 1
    end
}
print(f"errors: {errors}")
