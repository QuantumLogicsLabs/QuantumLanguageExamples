// Mixed-syntax example 250: temperature conversion table
# Syntax used: arrow functions, C++, Quantum fn, JavaScript, Python blocks

let to_f = (c) => {
    return c * 9 / 5 + 32
}
fn to_k(c):
    return c + 273.15
for c in [-6, -14, -9, -19, 42, -16, -13]:
    print(format("%4d C = %7.2f F = %7.2f K", c, to_f(c), to_k(c)))
hot = 0
for (const auto& c : [-6, -14, -9, -19, 42, -16, -13]) {
    if to_f(c) > 80:
        hot += 1
}
console.log(`hot days: ${hot}`)
