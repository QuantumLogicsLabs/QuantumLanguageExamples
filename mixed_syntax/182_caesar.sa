// Mixed-syntax example 182: Caesar cipher with shift 24
# Syntax used: C++, JavaScript, Python blocks, Ruby do/end

def shift(text, k)
    out = ""
    (0...len(text)).each do |i|
        ch = text[i]
        let code = ord(ch)
        if code >= 97 and code <= 122:
            out = out + chr((code - 97 + k) % 26 + 97)
        elif code >= 65 and code <= 90:
            out = out + chr((code - 65 + k) % 26 + 65)
        else:
            out = out + ch
    end
    return out
end
for (const m of ["orbit island lemon", "ocean delta comet", "WILLOW lantern"]) {
    let enc = shift(m, 24);
    let dec = shift(enc, 2)
    console.log(m, "->", enc)
    if dec == m:
        cout << ("round trip ok") << endl
    else:
        cout << ("round trip FAILED") << "\n"
}
