// Mixed-syntax example 407: vowel and consonant counts
# Syntax used: arrow functions, brace blocks, C++, JavaScript, Python blocks, Ruby do/end

def is_vowel(ch)
    for v in ["a", "e", "i", "o", "u"] {
        if ch == v:
            return 1
    }
    return 0
end
let count_vowels = (s) => {
    int n = 0
    for i in range(0, len(s)):
        n += is_vowel(s[i])
    return n;
}
for s in ["tiger orbit lantern willow maple", "meadow velvet ember", "orbit velvet pepper lemon"]:
    let v = count_vowels(s);
    int letters = 0
    for i in range(0, len(s)) {
        if s[i] != " "
            letters += 1
        end
    }
    print(str(s) + ": " + str(v) + " vowels, " + str(letters - v) + " consonants")
