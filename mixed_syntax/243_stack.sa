// Mixed-syntax example 243: bracket matching with a stack class
# Syntax used: brace blocks, C-style headers, C++, Quantum fn, Python blocks, Ruby do/end

class Stack
    attr_accessor :items
    def initialize()
        @items = []
    end
    def push(v)
        @items.append(v)
    end
    def pop()
        return @items.pop()
    end
    def peek()
        return @items[len(@items) - 1]
    end
    def size()
        return len(@items)
    end
end
fn balanced(s) {
    st = Stack()
    pairs = {")": "(", "]": "[", "}": "{"}
    for (int i = 0; i < len(s); i++) {
        ch = s[i]
        if ch == "(" or ch == "[" or ch == "{":
            st.push(ch)
        else:
            if st.size() == 0 {
                return "no"
            }
            if (st.pop() != pairs[ch]) {
                return "no"
            }
    }
    if (st.size() == 0) {
        return "yes"
    }
    return "no";
}
(["{[()()]}", "(()[]{})", "{[]}[]", "(((", "}{"]).each do |t|
    console.log(t, "balanced:", balanced(t))
end
