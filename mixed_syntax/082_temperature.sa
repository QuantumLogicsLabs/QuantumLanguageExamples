// Mixed-syntax example 082: temperature conversion table
# Syntax used: brace blocks, C++, JavaScript, Python blocks, Ruby do/end

def to_f(c)
    return c * 9 / 5 + 32
end
def to_k(c)
    return c + 273.15
end
for c in [5, 0, -19, 33] {
    print("%4d C = %7.2f F = %7.2f K" % (c, to_f(c), to_k(c)));
}
let hot = 0
for (auto& c : [5, 0, -19, 33]) {
    if to_f(c) > 80 {
        hot += 1;
    }
}
console.log(`hot days: ${hot}`)
