// Mixed-syntax example 499: functions returning functions
# Syntax used: arrow functions, C++, Quantum fn, JavaScript, Ruby do/end

function make_adder(n) {
    fn add(x) {
        return x + n;
    }
    return add
}
const apply_twice = (f, x) => {
    return f(f(x))
}
([16, 12, 17]).each do |k|
    let f = make_adder(k)
    cout << "add " << (k) << ": " << (f(10)) << ", twice: " << (apply_twice(f, 10)) << endl
end
