// Mixed-syntax example 339: Fibonacci sequence of 18 terms
# Syntax used: brace blocks, C-style headers, Quantum fn, JavaScript, Python blocks

fn fib_list(n) {
    let seq = [0, 1];
    while len(seq) < n:
        seq.push_back(seq[len(seq) - 1] + seq[len(seq) - 2])
    return seq;
}
fn fib_rec(n) {
    if n < 2 {
        return n
    }
    return fib_rec(n - 1) + fib_rec(n - 2)
}
let seq = fib_list(18)
console.log(seq)
print(f"fib_rec({9}) = {fib_rec(9)}")
let evens = 0
for v in seq:
    if (v % 2 == 0) {
        evens += 1;
    }
print("even terms: " + str(evens))
