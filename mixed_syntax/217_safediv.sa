// Mixed-syntax example 217: exceptions from a safe division helper
# Syntax used: C++, JavaScript, Python blocks, Ruby do/end

def safe_div(a, b)
    if b == 0
        throw new Error("division by zero")
    end
    return floor(a / b)
end
errors = 0
for p in [[92, 3], [91, 0], [81, 3], [8, 1], [36, 8], [50, 4]]:
    try {
        print(f"{p[0]} / {p[1]} = {safe_div(p[0], p[1])}");
    } catch (err) {
        console.log(str(p[0]) + " / " + str(p[1]) + " failed")
        errors += 1;
    }
cout << "errors: " << (errors) << endl
