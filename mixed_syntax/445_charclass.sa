// Mixed-syntax example 445: character classes in strings
# Syntax used: C-style headers, C++, JavaScript, Python blocks

function classify(s) {
    up = 0
    int low = 0
    let dig = 0
    let other = 0
    for i in range(0, len(s)):
        c = ord(s[i])
        if (c >= 65 && c <= 90) {
            up += 1
        } else if (c >= 97 && c <= 122) {
            low += 1;
        } else if (c >= 48 and c <= 57) {
            dig += 1
        } else {
            other += 1
        }
    return [up, low, dig, other]
}
for (let s of ["e = mc^2", "Quantum2026 Rocks!", "abc DEF 123 xyz"]) {
    c = classify(s)
    cout << (s) << ": upper " << (c[0]) << ", lower " << (c[1]) << ", digits " << (c[2]) << ", other " << (c[3]) << endl
}
