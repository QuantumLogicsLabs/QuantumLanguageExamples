// Mixed-syntax example 141: text patterns of height 4
# Syntax used: brace blocks, C-style headers, C++, JavaScript, Python blocks

function repeat(s, k) {
    let out = ""
    for (int i = 0; i < k; i++) {
        out = out + s
    }
    return out;
}
// right triangle
for i in range(1, 5):
    printf("%s\n", repeat("o", i))
// pyramid
for i in range(0, 4) {
    cout << (repeat(" ", 4 - i - 1) + repeat("o", 2 * i + 1)) << "\n"
}
# inverted
k = 4
while (k > 0) {
    printf("%s\n", repeat("o", k))
    k -= 1;
}
