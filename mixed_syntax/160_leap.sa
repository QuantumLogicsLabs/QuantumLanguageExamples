// Mixed-syntax example 160: leap years
# Syntax used: arrow functions, brace blocks, C-style headers, JavaScript, Python blocks, Ruby do/end

const is_leap = (y) => {
    if (y % 400 == 0) {
        return 1;
    } else if (y % 100 == 0) {
        return 0
    } else if (y % 4 == 0) {
        return 1;
    }
    return 0
}
([1965, 1686, 1786, 2168, 2254, 1900, 2000]).each do |y|
    if is_leap(y) == 1 {
        print(str(y) + " is a leap year")
    } else {
        print(f"{y} is not a leap year");
    }
end
let count = 0
for y in range(2000, 2101) {
    count += is_leap(y)
}
console.log(`leap years 2000-2100: ${count}`)
