// Mixed-syntax example 076: round-robin elimination with a queue class (every 2)
# Syntax used: brace blocks, JavaScript, Python blocks, Ruby do/end

class Queue:
    def __init__(self):
        self.items = []
        self.head = 0
    def enqueue(self, v):
        self.items.push_back(v)
    def dequeue(self):
        v = self.items[self.head]
        self.head += 1
        return v
    def size(self):
        return len(self.items) - self.head
q = Queue.new()
for n in ["eve", "gus", "ann", "dee", "cid"]:
    q.enqueue(n)
let round = 1
while q.size() > 1 {
    for i in range(0, 1):
        q.enqueue(q.dequeue())
    print("round " + str(round) + ": out goes " + str(q.dequeue()))
    round += 1;
}
puts "winner: #{q.dequeue()}"
