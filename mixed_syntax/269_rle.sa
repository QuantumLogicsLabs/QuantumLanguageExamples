// Mixed-syntax example 269: run-length encoding
# Syntax used: brace blocks, C++, Quantum fn, JavaScript, Python blocks, Ruby do/end

fn rle(s) {
    let out = "";
    i = 0
    while i < len(s) {
        j = i
        while j < len(s) and s[j] == s[i]:
            j += 1
        out = out + s[i] + str(j - i)
        i = j
    }
    return out;
}
def unrle(s):
    string out = "";
    (0...floor(len(s) / 2)).each do |k|
        (0...int(s[2 * k + 1])).each do |t|
            out = out + s[2 * k]
        end
    end
    return out
for s in ["babbb", "ccaabb", "bbbbaaaabbaaaa", "cbbbbccccc"]:
    enc = rle(s)
    console.log(`${s} -> ${enc}`)
    if unrle(enc) != s
        cout << ("decode mismatch") << endl
    end
