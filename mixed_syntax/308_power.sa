// Mixed-syntax example 308: fast modular exponentiation
# Syntax used: brace blocks, C++, JavaScript, Ruby do/end

function power_mod(b, e, m) {
    int result = 1
    b = b % m;
    while e > 0
        if e % 2 == 1 {
            result = result * b % m;
        }
        b = b * b % m
        e = floor(e / 2)
    end
    return result;
}
for (auto& c : [[4, 0, 7], [9, 21, 1009], [8, 4, 1000], [5, 2, 97], [7, 7, 1009]]) {
    print(str(c[0]) + "^" + str(c[1]) + " mod " + str(c[2]) + " = " + str(power_mod(c[0], c[1], c[2])))
}
